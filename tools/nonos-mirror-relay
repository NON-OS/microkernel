"""Serve package mirrors to a booted guest, through this machine's proxy.

The guest's installer speaks plain HTTP to an address, with the mirror's
name as the Host line. This relay listens on loopback (10.0.2.2 to a QEMU
guest on user networking), refuses any Host line not on its list, fetches
the path over HTTPS through HTTPS_PROXY, caches it, and returns it. Nothing
it relays needs to be trusted: every file is held to its distribution's
signature inside the guest. It never dials a mirror directly.

A package the market catalogue lists is served only as the bytes its lock
pins (userland/capsule_market/linux-catalogue.lock.json, B), or not at all:
502, and the cached copy dropped. --tamper APP serves APP's package with one
byte changed, so a development image's boot can show the guest refusing
bytes its pin does not name. A development image (dev-mirror) dials this
relay at 10.0.2.2:8080 (docs/build/dev-mirror.md); no release image does.
"""

import argparse
import hashlib
import http.server
import os
import pathlib
import ssl
import sys
import urllib.error
import urllib.request

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from nonos_market_catalogue import digest, lock_file
from nonos_mirror_relay import pins as pinning

LOCK = pathlib.Path(__file__).resolve().parent.parent / "userland/capsule_market/linux-catalogue.lock.json"

HOSTS = {
    "dl-cdn.alpinelinux.org",
    "geo.mirror.pkgbuild.com",
    "www.blackarch.org",
    "deb.debian.org",
    "kali.download",
}


def fetcher(ca):
    ctx = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
    proxy = urllib.request.ProxyHandler()  # HTTPS_PROXY from the environment
    return urllib.request.build_opener(proxy, urllib.request.HTTPSHandler(context=ctx))


def handler(cache, opener, log, pins, tamper):
    class Relay(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            host = self.headers.get("Host", "").split(":")[0]
            if host not in HOSTS or ".." in self.path or not self.path.startswith("/"):
                return self.reply(403, b"refused\n", f"refused {host}{self.path}")
            key = cache / hashlib.sha256(f"{host}{self.path}".encode()).hexdigest()
            if not key.exists():
                try:
                    with opener.open(f"https://{host}{self.path}", timeout=120) as r:
                        body = r.read()
                except urllib.error.HTTPError as e:
                    return self.reply(e.code, b"", f"{e.code} {host}{self.path}")
                except OSError as e:
                    return self.reply(502, b"", f"502 {host}{self.path}: {e}")
                key.write_bytes(body)
            try:
                body = pinning.checked(host, self.path, key.read_bytes(), pins, tamper, digest.blake3)
            except ValueError as why:
                key.unlink(missing_ok=True)
                return self.reply(502, b"", f"502 {why}")
            pin = pinning.pinned(host, self.path, pins)
            mark = " pinned" + (" TAMPERED" if pin[0] in tamper else "") if pin else ""
            self.reply(200, body, f"200 {len(body):9} {host}{self.path}{mark}")

        def reply(self, code, body, line):
            print(line, file=log, flush=True)
            self.send_response(code)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_):
            pass

    return Relay


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", type=int, default=8080, help="the loopback port to listen on (default 8080)")
    ap.add_argument("--cache", type=pathlib.Path, required=True, help="where fetched files are kept")
    ap.add_argument("--ca", default=os.environ.get("SSL_CERT_FILE") or "/root/.ccr/ca-bundle.crt",
                    help="the CA bundle the proxy's certificates chain to")
    ap.add_argument("--tamper", action="append", default=[], metavar="APP",
                    help="serve the locked APP's package with one byte changed (repeatable)")
    a = ap.parse_args()
    try:
        pins = lock_file.read(LOCK)
    except (ValueError, TypeError, OSError) as why:
        sys.exit(f"relay: {LOCK}: {why}")
    unknown = sorted(set(a.tamper) - set(pins))
    if unknown:
        ap.error(f"--tamper: not a locked app: {', '.join(unknown)}")
    a.cache.mkdir(parents=True, exist_ok=True)
    ca = a.ca if os.path.exists(a.ca) else None
    server = http.server.ThreadingHTTPServer(("127.0.0.1", a.port), handler(a.cache, fetcher(ca), sys.stdout, pins, set(a.tamper)))
    print(f"relay on 127.0.0.1:{a.port} for {', '.join(sorted(HOSTS))}, {len(pins)} locked apps"
          + (f", tampering {', '.join(a.tamper)}" if a.tamper else ""), flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
