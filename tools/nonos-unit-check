"""Check a unit's commits against the tree's rules before it is pushed.

    tools/nonos-unit-check                 against origin/main
    tools/nonos-unit-check --base REF      against REF
    tools/nonos-unit-check --reached       the userland crates the unit reaches
    tools/nonos-unit-check --self-test     the checks on a made repository

Every .rs file the unit adds or changes, from the merge base with REF to
HEAD, is held to:

  FMT    rustfmt --check, with the repository's rustfmt.toml and
         skip_children, as the the maintainers' gate runs it;
  OVER   at most 75 lines, and a file already over 75 may only shrink;
  ALLOW  no #[allow] or #![allow] added (scripts/check_allows.py says why);

and the unit's added lines may carry no private key material (KEY). Files
written by a tool that say not to edit them, and the extraction crates
tools/extraction/closure_crate.py writes, are skipped. The merge base, not
REF itself, is the comparison, so a unit that has not merged the newest main
is judged on its own commits alone. Exit 1 when anything is found.

--reached lists, proof crates first, every userland crate whose tests a unit
must run: one that holds a changed file; one with a file that mounts
(#[path], include_str!, include_bytes!) a changed file, or a directory or
mounted file that leads to one; or one naming such a crate as a path
dependency.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from functools import lru_cache
from pathlib import Path

LIMIT = 75
GENERATED = re.compile(r"Written by tools/.*do not|do not\s*\n//\s*edit\.", re.I)
# The extraction crates tools/extraction/closure_crate.py writes, as it writes them.
GENERATED_TREES = ("verification/extraction/tree/",)
ALLOW = re.compile(r"^\+.*#!?\[\s*allow\s*\(")
# Built from parts, so this file's own lines are not key material to itself.
KEY = re.compile(r"^\+.*(BEGIN (EC |OPENSSH |)PRIVATE KEY|NONOS_SIGNING_" + r"KEY=)", re.I)


def git(root, *args, check=True):
    r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise SystemExit(f"unit-check: git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def default_base(root):
    for ref in ("refs/remotes/origin/main", "refs/heads/main"):
        if git(root, "rev-parse", "--verify", "-q", ref, check=False).strip():
            return ref
    raise SystemExit("unit-check: no origin/main or main; pass --base")


def formatted(root, path):
    cmd = ["rustfmt", "--edition", "2021", "--check", "--config", "skip_children=true", path]
    return subprocess.run(cmd, cwd=root, capture_output=True).returncode == 0


def findings(root, base):
    since = git(root, "merge-base", base, "HEAD").strip()
    out = []
    changed = git(root, "diff", "--name-only", "--diff-filter=AM", since, "HEAD", "--", "*.rs")
    for path in changed.split():
        text = (root / path).read_text(errors="replace") if (root / path).exists() else None
        if text is None or GENERATED.search(text) or path.startswith(GENERATED_TREES):
            continue
        if not formatted(root, path):
            out.append(f"FMT {path}")
        now = text.count("\n")
        was = git(root, "show", f"{since}:{path}", check=False).count("\n")
        if now > LIMIT and now > was:
            out.append(f"OVER {was}->{now} {path}")
        diff = git(root, "diff", since, "HEAD", "--", path)
        if any(ALLOW.match(line) for line in diff.splitlines()):
            out.append(f"ALLOW {path}")
    if any(KEY.match(line) for line in git(root, "diff", since, "HEAD").splitlines()):
        out.append("KEY private key material in the unit's lines")
    return out


MOUNT = re.compile(r'#\[path\s*=\s*"([^"]+)"\]|include_(?:str|bytes)!\(\s*"([^"]+)"')
DEP = re.compile(r'path\s*=\s*"([^"]+)"')


def reached(root, base):
    since = git(root, "merge-base", base, "HEAD").strip()
    changed = {(root / p).resolve() for p in git(root, "diff", "--name-only", since, "HEAD").split()}
    under = lambda p, d: str(p).startswith(str(d) + "/")

    def mounts(f):
        try:
            text = f.read_text(errors="replace")
        except OSError:
            return []
        return [(f.parent / (m.group(1) or m.group(2))).resolve() for m in MOUNT.finditer(text)]

    @lru_cache(maxsize=None)
    def touches(f, depth=0):
        if f in changed or depth > 12:
            return f in changed
        if f.is_dir():
            files = [g for g in f.rglob("*.rs") if "/target/" not in str(g)]
            return any(under(c, f) for c in changed) or any(touches(g, depth + 1) for g in files)
        return f.suffix == ".rs" and any(touches(d, depth + 1) for d in mounts(f))

    crates = sorted(p.parent.resolve() for p in (root / "userland").glob("*/Cargo.toml"))
    found = set()
    for crate in crates:
        own = (r for r in crate.rglob("*.rs") if "/target/" not in str(r))
        if any(under(c, crate) for c in changed) or any(touches(d) for r in own for d in mounts(r)):
            found.add(crate)
    deps = {c: {(c / m.group(1)).resolve() for m in DEP.finditer((c / "Cargo.toml").read_text())}
            for c in crates}
    grew = True
    while grew:
        grew = False
        for crate in crates:
            if crate not in found and deps[crate] & found:
                found.add(crate)
                grew = True
    order = sorted(found, key=lambda c: (not c.name.endswith("_proofs"), c.name))
    return [str(c.relative_to(root.resolve())) for c in order]


def self_test():
    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        env = {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
               "GIT_COMMITTER_EMAIL": "t@t"}
        os.environ.update(env)
        git(root, "init", "-q", "-b", "main")
        (root / "rustfmt.toml").write_text('edition = "2021"\nuse_small_heuristics = "Max"\n')
        body = lambda n: "".join(f"    let _v{i} = {i};\n" for i in range(n))
        long_fn = body(80)
        (root / "grown.rs").write_text(f"pub fn f() {{\n{long_fn}}}\n")
        (root / "kept.rs").write_text(f"pub fn k() {{\n{body(88)}}}\n")
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "base")
        git(root, "checkout", "-q", "-b", "unit")
        (root / "grown.rs").write_text(f"pub fn f() {{\n{long_fn}    let _w = 1;\n}}\n")
        (root / "kept.rs").write_text(f"pub fn k() {{\n{body(83)}}}\n")
        (root / "new_long.rs").write_text(f"pub fn n() {{\n{long_fn}}}\n")
        (root / "off.rs").write_text("pub fn o( ) -> u8 {1}\n")
        (root / "allowed.rs").write_text("#[allow(dead_code)]\nfn a() {}\n")
        (root / "gen.rs").write_text("// Written by tools/x.py; do not edit.\npub fn g( ) {}\n")
        (root / "verification/extraction/tree/x").mkdir(parents=True)
        (root / "verification/extraction/tree/x/mod.rs").write_text("pub use a::{b,c};\n")
        (root / "notes.txt").write_text("-----BEGIN " + "PRIVATE KEY-----\n")
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "unit")
        got = sorted(findings(root, "main"))
        want = sorted(["OVER 82->83 grown.rs", "OVER 0->82 new_long.rs", "FMT off.rs",
                       "ALLOW allowed.rs", "KEY private key material in the unit's lines"])
        if got != want:
            print(f"unit-check: self-test failed\n  got  {got}\n  want {want}")
            return 1
        git(root, "checkout", "-q", "main")
        git(root, "checkout", "-q", "-b", "clean")
        (root / "kept.rs").write_text(f"pub fn k() {{\n{body(83)}}}\n")
        git(root, "commit", "-q", "-am", "shrink")
        git(root, "checkout", "-q", "main")
        (root / "later.rs").write_text("pub fn l( ) {}\n")
        (root / "grown.rs").write_text(f"pub fn f() {{\n{body(79)}}}\n")
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "main moves on: a file off rustfmt, one shrunk")
        git(root, "checkout", "-q", "clean")
        if findings(root, "main"):
            print(f"unit-check: self-test failed, a clean unit was refused: {findings(root, 'main')}")
            return 1
    if not reached_self_test():
        return 1
    print("unit-check: self-test passed, 5 findings made and caught, a clean unit passed,")
    print("unit-check: and --reached found each crate a change reaches and no other")
    return 0


def reached_self_test():
    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        git(root, "init", "-q", "-b", "main")
        for name, toml_extra, src in [
            ("lib_a", "", "pub fn a() {}\n"),
            ("by_path_proofs", "", '#[path = "../../lib_a/src/lib.rs"]\nmod a;\n'),
            ("by_text_proofs", "", 'const A: &str = include_str!("../../lib_a/src/lib.rs");\n'),
            ("by_dep_proofs", '\n[dependencies]\nlib_a = { path = "../lib_a" }\n', ""),
            ("lib_b", "", '#[path = "../../lib_a/src/lib.rs"]\nmod a;\npub fn b() {}\n'),
            ("by_chain_proofs", "", '#[path = "../../lib_b/src/lib.rs"]\nmod b;\n'),
            ("unrelated_proofs", "", '#[path = "../../lib_c/src/lib.rs"]\nmod c;\n'),
            ("lib_c", "", "pub fn c() {}\n"),
        ]:
            (root / "userland" / name / "src").mkdir(parents=True)
            (root / "userland" / name / "Cargo.toml").write_text(f'[package]\nname = "{name}"\n{toml_extra}')
            (root / "userland" / name / "src/lib.rs").write_text(src)
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "base")
        (root / "userland/lib_a/src/lib.rs").write_text("pub fn a() -> u8 { 1 }\n")
        git(root, "commit", "-q", "-am", "unit")
        got = reached(root, "main~1")
        want = ["userland/by_chain_proofs", "userland/by_dep_proofs", "userland/by_path_proofs",
                "userland/by_text_proofs", "userland/lib_a", "userland/lib_b"]
        if got != want:
            print(f"unit-check: --reached self-test failed\n  got  {got}\n  want {want}")
            return False
    return True


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--base", help="the branch the unit lands on")
    ap.add_argument("--reached", action="store_true", help="list the crates whose tests to run")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()
    if args.self_test:
        return self_test()
    root = Path(git(Path.cwd(), "rev-parse", "--show-toplevel").strip())
    base = args.base or default_base(root)
    if args.reached:
        print("\n".join(reached(root, base)))
        return 0
    found = findings(root, base)
    for f in found:
        print(f"unit-check: {f}")
    print(f"unit-check: {len(found)} found against {base}" if found else "unit-check: clean")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
