"""Check a unit's commits against the tree's rules before it is pushed.

    tools/nonos-unit-check                 against private/main (or origin/main)
    tools/nonos-unit-check --base REF      against REF
    tools/nonos-unit-check --self-test     the checks on a made repository

Every .rs file the unit adds or changes, from the merge base with REF to
HEAD, is held to:

  FMT    rustfmt --check, with the repository's rustfmt.toml and
         skip_children, as the lead's gate runs it;
  OVER   at most 75 lines, and a file already over 75 may only shrink;
  ALLOW  no #[allow] or #![allow] added (scripts/check_allows.py says why);

and the unit's added lines may carry no private key material (KEY). Files
written by a tool that say not to edit them are skipped. The merge base, not
REF itself, is the comparison, so a unit that has not merged the newest main
is judged on its own commits alone. Exit 1 when anything is found.
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

LIMIT = 75
GENERATED = re.compile(r"Written by tools/.*do not|do not\s*\n//\s*edit\.", re.I)
ALLOW = re.compile(r"^\+.*#!?\[\s*allow\s*\(")
KEY = re.compile(r"^\+.*(BEGIN (EC |OPENSSH |)PRIVATE KEY|NONOS_SIGNING_KEY=)", re.I)


def git(root, *args, check=True):
    r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    if check and r.returncode != 0:
        raise SystemExit(f"unit-check: git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def default_base(root):
    for ref in ("refs/remotes/private/main", "refs/remotes/origin/main", "refs/heads/main"):
        if git(root, "rev-parse", "--verify", "-q", ref, check=False).strip():
            return ref
    raise SystemExit("unit-check: no private/main, origin/main or main; pass --base")


def formatted(root, path):
    cmd = ["rustfmt", "--edition", "2021", "--check", "--config", "skip_children=true", path]
    return subprocess.run(cmd, cwd=root, capture_output=True).returncode == 0


def findings(root, base):
    since = git(root, "merge-base", base, "HEAD").strip()
    out = []
    changed = git(root, "diff", "--name-only", "--diff-filter=AM", since, "HEAD", "--", "*.rs")
    for path in changed.split():
        text = (root / path).read_text(errors="replace") if (root / path).exists() else None
        if text is None or GENERATED.search(text):
            continue
        if not formatted(root, path):
            out.append(f"FMT {path}")
        now = text.count("\n")
        was = git(root, "show", f"{since}:{path}", check=False).count("\n")
        if now > LIMIT and now > was:
            out.append(f"OVER {was}->{now} {path}")
        diff = git(root, "diff", since, "HEAD", "--", path)
        if any(ALLOW.match(line) for line in diff.splitlines()):
            out.append(f"ALLOW {path}")
    if any(KEY.match(line) for line in git(root, "diff", since, "HEAD").splitlines()):
        out.append("KEY private key material in the unit's lines")
    return out


def self_test():
    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        env = {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
               "GIT_COMMITTER_EMAIL": "t@t"}
        os.environ.update(env)
        git(root, "init", "-q", "-b", "main")
        (root / "rustfmt.toml").write_text('edition = "2021"\nuse_small_heuristics = "Max"\n')
        body = lambda n: "".join(f"    let _v{i} = {i};\n" for i in range(n))
        long_fn = body(80)
        (root / "grown.rs").write_text(f"pub fn f() {{\n{long_fn}}}\n")
        (root / "kept.rs").write_text(f"pub fn k() {{\n{body(88)}}}\n")
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "base")
        git(root, "checkout", "-q", "-b", "unit")
        (root / "grown.rs").write_text(f"pub fn f() {{\n{long_fn}    let _w = 1;\n}}\n")
        (root / "kept.rs").write_text(f"pub fn k() {{\n{body(83)}}}\n")
        (root / "new_long.rs").write_text(f"pub fn n() {{\n{long_fn}}}\n")
        (root / "off.rs").write_text("pub fn o( ) -> u8 {1}\n")
        (root / "allowed.rs").write_text("#[allow(dead_code)]\nfn a() {}\n")
        (root / "gen.rs").write_text("// Written by tools/x.py; do not edit.\npub fn g( ) {}\n")
        (root / "notes.txt").write_text("-----BEGIN PRIVATE KEY-----\n")
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "unit")
        got = sorted(findings(root, "main"))
        want = sorted(["OVER 82->83 grown.rs", "OVER 0->82 new_long.rs", "FMT off.rs",
                       "ALLOW allowed.rs", "KEY private key material in the unit's lines"])
        if got != want:
            print(f"unit-check: self-test failed\n  got  {got}\n  want {want}")
            return 1
        git(root, "checkout", "-q", "main")
        git(root, "checkout", "-q", "-b", "clean")
        (root / "kept.rs").write_text(f"pub fn k() {{\n{body(83)}}}\n")
        git(root, "commit", "-q", "-am", "shrink")
        git(root, "checkout", "-q", "main")
        (root / "later.rs").write_text("pub fn l( ) {}\n")
        (root / "grown.rs").write_text(f"pub fn f() {{\n{body(79)}}}\n")
        git(root, "add", "-A")
        git(root, "commit", "-q", "-m", "main moves on: a file off rustfmt, one shrunk")
        git(root, "checkout", "-q", "clean")
        if findings(root, "main"):
            print(f"unit-check: self-test failed, a clean unit was refused: {findings(root, 'main')}")
            return 1
    print("unit-check: self-test passed, 5 findings made and caught, a clean unit passed")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--base", help="the branch the unit lands on")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()
    if args.self_test:
        return self_test()
    root = Path(git(Path.cwd(), "rev-parse", "--show-toplevel").strip())
    base = args.base or default_base(root)
    found = findings(root, base)
    for f in found:
        print(f"unit-check: {f}")
    print(f"unit-check: {len(found)} found against {base}" if found else "unit-check: clean")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
