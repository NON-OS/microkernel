"""The standard library of a CPython build as the zip its getpath finds at
<prefix>/lib/python312.zip: every module's source, and its bytecode as an
unchecked hash-based .pyc, which zipimport loads as is, so nothing is compiled
at start and tracebacks still show the source. The tests, the Tk and IDLE
modules and the bundled pip are left out. Entries are sorted and stamped
with one date, and in the generated sysconfig module the build directory is
mapped to /build and the repository, where the toolchains live, to /nonos, so
the same sources give the same bytes on any machine.

    tools/nonos-python-stdlib-zip SRC BUILD_ROOT REPO_ROOT OUT

Run with the build's own Python: bytecode is only valid for its version."""

import importlib.util
import marshal
import os
import re
import sys
import zipfile

SKIP = {"test", "idlelib", "tkinter", "turtledemo", "ensurepip", "lib2to3", "__pycache__",
        "site-packages", "__phello__"}
STAMP = (2026, 9, 30, 0, 0, 0)
UNCHECKED_HASH = 0b01

# Build-host-only variables recorded in _sysconfigdata, pinned to the Unix
# target's value so the file does not depend on the machine that built it:
# - On a case-insensitive APFS (macOS), CPython's configure finds its own output
#   executable under a second spelling and concludes the platform carries an
#   .exe suffix, setting BUILDEXE (and the EXE family) to ".exe" and BUILDPYTHON
#   to "python.exe"; the Linux personality is a Unix target with no such suffix.
# - GNULD is configure's verdict on whether the linker is GNU ld, which comes
#   out "yes" on a Linux host and "no" on a macOS one. It is recorded for a
#   runtime that never links, so it is pinned to the Linux target's "yes".
# The toolchain paths these files also record live under the build and the
# repository roots and are folded to /build and /nonos in canonicalise below.
SYSCONFIG_PIN = {"EXE": "", "EXEEXT": "", "BUILDEXE": "", "BUILDPYTHON": "python", "GNULD": "yes"}
# Any .exe that survives canonicalisation is a build-host residue the pin above
# did not cover; the build must fail rather than ship host-dependent bytes.
SYSCONFIG_RESIDUE = re.compile(rb"\.exe\b")


def sources(src):
    lib = os.path.join(src, "Lib")
    for root, dirs, names in os.walk(lib):
        dirs[:] = sorted(d for d in dirs if d not in SKIP)
        for name in sorted(names):
            if name.endswith(".py"):
                path = os.path.join(root, name)
                yield os.path.relpath(path, lib), path
    built = os.path.join(src, open(os.path.join(src, "pybuilddir.txt")).read().strip())
    for name in sorted(os.listdir(built)):
        if name.startswith("_sysconfigdata_") and name.endswith(".py"):
            yield name, os.path.join(built, name)


def pyc(source, arcname):
    code = compile(source, f"/usr/lib/python312.zip/{arcname}", "exec", dont_inherit=True)
    flags = UNCHECKED_HASH.to_bytes(4, "little")
    return importlib.util.MAGIC_NUMBER + flags + importlib.util.source_hash(source) + marshal.dumps(code)


def canonicalize_sysconfig(data, maps):
    """Rewrite a _sysconfigdata module to bytes that do not depend on the host
    that built it. The module is one assignment, `build_time_vars = {...}`, so
    it is parsed to the dict, every build-machine path in a string value is
    folded by the maps, the build-host-only variables are pinned, and the dict
    is written back sorted, one entry per line, each value as repr. Rebuilding
    the text this way rather than editing it in place drops the line wrapping
    CPython's pprint applies, which it does differently on different hosts and
    which, once the paths were folded, was all that still differed."""
    ns = {}
    exec(compile(data, "_sysconfigdata", "exec"), ns)  # our own build output
    v = dict(ns["build_time_vars"])

    def fold(s):
        for frm, to in maps:
            s = s.replace(frm, to)
        return s

    v = {k: (fold(val) if isinstance(val, str) else val) for k, val in v.items()}
    for key, val in SYSCONFIG_PIN.items():
        if key in v:
            v[key] = val
    body = "".join("    %r: %r,\n" % (k, v[k]) for k in sorted(v))
    return ("build_time_vars = {\n" + body + "}\n").encode()


def residue_check(arcname, data):
    """Fail closed if a build-host residue survived canonicalisation."""
    m = SYSCONFIG_RESIDUE.search(data)
    if m:
        ctx = data[max(0, m.start() - 40):m.end() + 40].decode("utf-8", "replace")
        raise SystemExit(
            f"{arcname}: build-host residue {m.group().decode()!r} remains after "
            f"normalisation, near: ...{ctx}...")


def put(zf, arcname, data):
    info = zipfile.ZipInfo(arcname, STAMP)
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = 0o644 << 16
    zf.writestr(info, data, compresslevel=9)


def self_test():
    maps = [("/build/x", "/build"), ("/nonos/y", "/nonos")]
    # A macOS-shaped file: the .exe family and BUILDPYTHON set, GNULD "no", a
    # build path to fold, and a long value pprint wrapped across two literals.
    mac = (b"build_time_vars = {\n"
           b"    'BUILDEXE': '.exe',\n"
           b'    "EXEEXT": ".exe",\n'
           b"    'EXE': '.exe',\n"
           b"    'BUILDPYTHON': 'python.exe',\n"
           b"    'GNULD': 'no',\n"
           b"    'CC': '/build/x/clang',\n"
           b"    'LDFLAGS': ('-Wl,--gc-sections '\n"
           b"                '-L/build/x/lib'),\n"
           b"}\n")
    out = canonicalize_sysconfig(mac, maps)
    assert b"'BUILDEXE': ''" in out, out
    assert b"'EXEEXT': ''" in out, out
    assert b"'EXE': ''" in out, out
    assert b"'BUILDPYTHON': 'python'" in out, out
    assert b"'GNULD': 'yes'" in out, out
    assert b"'CC': '/build/clang'" in out, "build paths are folded"
    assert b"'LDFLAGS': '-Wl,--gc-sections -L/build/lib'" in out, "wrapping is dropped"
    residue_check("sample", out)  # must not raise
    # The same variables with the Linux spelling and no wrapping must give the
    # exact same bytes: that host-independence is the point.
    linux = (b"build_time_vars = {\n"
             b"    'BUILDEXE': '',\n"
             b"    'EXEEXT': '',\n"
             b"    'EXE': '',\n"
             b"    'BUILDPYTHON': 'python',\n"
             b"    'GNULD': 'yes',\n"
             b"    'CC': '/build/x/clang',\n"
             b"    'LDFLAGS': '-Wl,--gc-sections -L/build/x/lib',\n"
             b"}\n")
    assert canonicalize_sysconfig(linux, maps) == out, "two hosts must agree"
    # A residue the pin did not cover must fail the check.
    try:
        residue_check("leftover", b"'SOMEVAR': 'foo.exe'")
    except SystemExit:
        pass
    else:
        raise AssertionError("residue_check did not catch a surviving .exe")
    print("SELF-TEST OK")


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        self_test()
        return
    src, build_root, repo_root, out = sys.argv[1:5]
    # Every spelling the build may have recorded, as given, normalised and
    # with symlinks resolved, the longest first so none leaves a tail.
    def spellings(path, to):
        return [(p, to) for p in {path, os.path.normpath(path), os.path.realpath(path)}]
    maps = sorted(spellings(build_root, "/build") + spellings(repo_root, "/nonos"),
                  key=lambda m: len(m[0]), reverse=True)
    entries = sorted(sources(src))
    with zipfile.ZipFile(out + ".part", "w") as zf:
        for arcname, path in entries:
            data = open(path, "rb").read()
            if arcname.startswith("_sysconfigdata_"):
                data = canonicalize_sysconfig(data, maps)
                residue_check(arcname, data)
            put(zf, arcname, data)
            put(zf, arcname[:-3] + ".pyc", pyc(data, arcname))
    os.replace(out + ".part", out)
    print(f"{out}: {len(entries)} modules, {os.path.getsize(out)} bytes")


if __name__ == "__main__":
    main()
