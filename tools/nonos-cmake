# The cmake llama.cpp is configured with, release 4.4.3. Prints the path of the
# cmake binary. The flake pins it (tools/nix/pins.nix) and says where it is in
# NONOS_CMAKE, both in `nix develop` and inside `nix build`; outside the flake
# there is no pinned cmake, so this refuses rather than use whatever the host has.
#   tools/nonos-cmake

set -eu

if [ -z "${NONOS_CMAKE:-}" ]; then
	echo "nonos-cmake: the pinned cmake comes from the flake; run this inside nix develop" >&2
	exit 1
fi
echo "$NONOS_CMAKE"
