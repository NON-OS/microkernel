# The zig the Linux userland and the Qwen runner are cross-built with, release
# 0.16.0. Prints the path of the
# zig binary. The flake pins it (tools/nix/pins.nix) and says where it is in
# NONOS_ZIG, both in `nix develop` and inside `nix build`; outside the flake
# there is no pinned zig, so this refuses rather than use whatever the host has.
#   tools/nonos-zig

set -eu

if [ -z "${NONOS_ZIG:-}" ]; then
	echo "nonos-zig: the pinned zig comes from the flake; run this inside nix develop" >&2
	exit 1
fi
echo "$NONOS_ZIG"
