# ---- The SOCKS endpoint lands on main soon. Until it has, cut this block. ----
# >>> monero
# ==== 8. Money that stays yours =============================================
key:ctrl+alt+t
pause:3
type:market install linux.monero
say:Monero's wallet, from the Marketplace. Its box allows no direct connection.
key:ret
after:[LINUX] installed:1800
pause:2
type:linux monero-wallet-cli --generate-new-wallet /root/tour --password tour --mnemonic-language English --daemon-address node.sethforprivacy.com:18089 --proxy 127.0.0.1:9050
key:ret
pause:20
say:A new wallet. Its node is reached through the SOCKS endpoint, over Anyone.
pause:10
say:The node sees an exit relay, not this machine.
pause:20
type:status
key:ret
pause:5
say:The wallet syncing with the node.
pause:8
type:exit
key:ret
pause:3
say:
key:ctrl+l
# <<< monero

# >>> qwen
# ==== 9. Your own AI =========================================================
key:ctrl+alt+t
pause:3
type:qwen what is a microkernel? Answer in one sentence.
key:ret
say:Qwen, a language model that runs here. No question leaves this machine.
pause:8
say:Its policy line: models read-only, a terminal, and no network at all.
pause:8
say:The model is checked against its signed pin before it is loaded.
pause:20
# The rehearsal under TCG reached "qwen: verified" and the load; the answer
# itself is seen only on KVM. Check its timing on the first KVM run.
say:The answer streams in as the model writes it, on this machine.
pause:20
type:/bye
key:ret
pause:3
say:
key:ctrl+l
# <<< qwen

