# Consent erase, boot B: the stick holds the token and the answers but no
# setup marker, so setup runs Amnesic and finds local software allowed. It
# is set back to Only NONOS software, which revokes and withdraws the token.
until:[SETUP-WIZARD] capsule spawned:1800
wait:360
key:ret
wait:20
type:zqconsentname
key:ret
wait:20
key:ret
wait:20
shot:b04-mode-amnesic
key:ret
wait:20
key:ret
wait:15
key:ret
wait:15
key:ret
wait:15
key:ret
wait:15
key:ret
wait:15
key:ret
wait:15
shot:b11-software-was-allowed
key:up
wait:10
shot:b11-software-only-nonos
key:ret
wait:20
type:zqconsenthost
key:ret
wait:20
shot:b13-review
key:ret
until:name=desktop_shell:1800
wait:150
shot:b20-desktop
