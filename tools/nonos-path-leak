"""Count the build paths a shipped binary still carries.

A panic location names the source file it was compiled from, so a kernel
built without -Zlocation-detail=none holds one `src/...rs` string per panic
site, plus the registry, toolchain and checkout paths of the crates those
sites live in. They describe the build host and the tree's layout to anyone
holding the image. This reads every printable run of four or more
bytes, as strings(1) does, and counts each class. Exit 1 when any class is
non-zero, so a build step can refuse a binary that leaks.

Usage: nonos-path-leak [--list] BINARY...
"""

import re
import sys

CLASSES = (
    ("source", re.compile(rb"(?:^|[^A-Za-z0-9_])(?:src|library)/[A-Za-z0-9_./-]*\.rs")),
    ("home", re.compile(rb"/(?:home|root|Users)/")),
    ("registry", re.compile(rb"\.cargo/(?:registry|git)/")),
    ("rustc", re.compile(rb"/rustc/[0-9a-f]{40}")),
    ("nix-store", re.compile(rb"/nix/store/[0-9a-z]{32}-")),
)

RUN = re.compile(rb"[\x20-\x7e]{4,}")


def scan(data):
    """Each class's matching runs, in file order."""
    found = {name: [] for name, _ in CLASSES}
    for run in RUN.finditer(data):
        text = run.group(0)
        for name, pat in CLASSES:
            if pat.search(text):
                found[name].append((run.start(), text))
    return found


def main(argv):
    show = "--list" in argv
    paths = [a for a in argv if a != "--list"]
    if not paths:
        print(__doc__.strip().splitlines()[-1], file=sys.stderr)
        return 2
    leaked = False
    for path in paths:
        with open(path, "rb") as f:
            found = scan(f.read())
        counts = " ".join(f"{n}={len(v)}" for n, v in found.items())
        print(f"{path}: {counts}")
        for name, hits in found.items():
            leaked |= bool(hits)
            if show:
                for off, text in hits:
                    print(f"  {name} 0x{off:x} {text[:160].decode('ascii')}")
    return 1 if leaked else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
