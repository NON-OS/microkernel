"""`make check`, out loud: every flake check built, and what each one proved.

It builds every check for this machine (each is cached until its inputs
change), then prints one line per check: passed or failed, and for a proof
crate the number of tests it ran. A failed check prints the end of its log.
Then the bill of materials: how many components, how many pinned by hash.
The same record goes to receipts/check-<system>.json; the exit status is
non-zero when any check failed.

    tools/nonos-check-report [--keep-going-jobs N]
"""

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

TESTS = re.compile(r"test result: (ok|FAILED)\. (\d+) passed; (\d+) failed")


def nix(*args, check=True):
    return subprocess.run(["nix", *args], capture_output=True, text=True, check=check)


def system():
    return nix("eval", "--raw", "--impure", "--expr", "builtins.currentSystem").stdout.strip()


def tests_in(out):
    log = Path(out) / "test.log"
    if not log.is_file():
        return None
    passed = 0
    for _, n, _ in TESTS.findall(log.read_text(errors="replace")):
        passed += int(n)
    return passed


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--jobs", default="auto")
    ap.add_argument("--receipts", default="receipts", type=Path)
    a = ap.parse_args()
    sysname = system()
    names = json.loads(nix("eval", "--json", f".#checks.{sysname}", "--apply", "builtins.attrNames").stdout)
    print(f"NONOS checks for {sysname}: {len(names)} to build", flush=True)
    drvs = json.loads(nix("eval", "--json", f".#checks.{sysname}", "--apply",
                          "cs: builtins.mapAttrs (_: c: c.drvPath) cs").stdout)
    # One nix build for all of them, so they share the machine's cores.
    subprocess.run(["nix", "build", "--keep-going", "--no-link", "--max-jobs", a.jobs, "-L"]
                   + [f".#checks.{sysname}.{n}" for n in names],
                   stdout=subprocess.DEVNULL, stderr=sys.stderr)
    rows = []
    for n in sorted(names):
        r = nix("path-info", f"{drvs[n]}^out", check=False)
        if r.returncode == 0 and r.stdout.strip():
            out = r.stdout.strip()
            rows.append({"check": n, "passed": True, "tests": tests_in(out), "output": out})
        else:
            log = nix("log", drvs[n], check=False).stdout.splitlines()
            rows.append({"check": n, "passed": False, "tests": None, "log_tail": log[-15:]})

    print()
    for row in rows:
        tests = f"{row['tests']:>6} tests" if row["tests"] is not None else " " * 12
        print(f"  {'PASS' if row['passed'] else 'FAIL'}  {tests}  {row['check']}")
    for row in rows:
        if not row["passed"]:
            print(f"\n--- {row['check']} ---")
            for line in row["log_tail"]:
                print(f"  {line}")

    sbom_out = nix("build", "--no-link", "--print-out-paths", ".#sbom", check=False).stdout.strip()
    sbom = {}
    if sbom_out:
        doc = json.loads(Path(sbom_out).read_text())
        comps = doc.get("components", [])
        sbom = {
            "components": len(comps),
            "pinned_by_hash": sum(1 for c in comps if c.get("hashes")),
            "path": sbom_out,
        }

    passed = [r for r in rows if r["passed"]]
    proofs = [r for r in passed if r["check"].startswith("proofs-")]
    tests = sum(r["tests"] or 0 for r in passed)
    statics = [r for r in passed if r["check"].startswith("static-")]
    print(f"\n{len(passed)} of {len(rows)} checks passed: {len(proofs)} proof crates running {tests} tests, "
          f"{len(statics)} static checks, and the rest")
    if sbom:
        print(f"bill of materials: {sbom['components']} components, {sbom['pinned_by_hash']} pinned by hash ({sbom['path']})")
    commit = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    a.receipts.mkdir(parents=True, exist_ok=True)
    record = {"format": "nonos-check/1", "commit": commit, "system": sysname,
              "passed": len(passed), "total": len(rows), "tests": tests, "sbom": sbom,
              "checks": [{k: v for k, v in r.items() if k != "output"} for r in rows]}
    (a.receipts / f"check-{sysname}.json").write_text(json.dumps(record, indent=1, sort_keys=True) + "\n")
    failed = [r["check"] for r in rows if not r["passed"]]
    if failed:
        sys.exit(f"\n{len(failed)} failed: {', '.join(failed)}")
    print("every check is green")


if __name__ == "__main__":
    main()
