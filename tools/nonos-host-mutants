"""Host mutants: each removes one rule from shipped source, and the host
proof that holds the rule must then fail. verification/host_mutants/*.json
lists them: name, file, one exact substitution (old, new), the crate
directory and the cargo test filter that must fail. The source is restored
after every mutant, whatever happens.

    tools/nonos-host-mutants FILE.json            run every mutant
    tools/nonos-host-mutants FILE.json --check    each applies exactly once
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path


def test(m) -> int:
    cmd = ["cargo", "test", "-q", *m.get("args", []), m["test"]]
    return subprocess.run(cmd, cwd=m["crate"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, check=False, timeout=1800).returncode


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("list", type=Path)
    ap.add_argument("--check", action="store_true", help="only check that each applies once")
    a = ap.parse_args()
    mutants = json.loads(a.list.read_text())
    stale = [m["name"] for m in mutants if Path(m["file"]).read_text().count(m["old"]) != 1]
    if stale or a.check:
        print(f"[host-mutant] {len(mutants) - len(stale)} of {len(mutants)} apply once; stale: {stale}")
        return 1 if stale else 0
    survivors = []
    for m in mutants:
        path = Path(m["file"])
        text = path.read_text()
        path.write_text(text.replace(m["old"], m["new"]))
        try:
            killed = test(m) != 0
        except subprocess.TimeoutExpired:
            killed = True
        finally:
            path.write_text(text)
        print(f"[host-mutant] {m['name']}: {'killed' if killed else 'SURVIVES'}")
        survivors += [] if killed else [m["name"]]
    print(f"[host-mutant] {len(mutants) - len(survivors)} of {len(mutants)} killed")
    return 1 if survivors else 0


if __name__ == "__main__":
    sys.exit(main())
