"""A development image to boot and test, in minutes, with no real key.

    tools/nonos-dev-image [--profile qemu]
    tools/nonos-dev-image --keys-only        the copy and its keys, no image
    tools/nonos-dev-image --nsh              with the nsh host capsules
    tools/nonos-dev-image --offline          no package mirror, no source recipes

With the package mirror on, the copy's guest fetches it from the host's
relay at 10.0.2.2:8080, as it fetches Alpine's packages. The copy's kernel
pairs the SimpleX window with its core's listing under the copy's
throwaway market operator, which signs the copy's catalogue.

It builds the profile's development twin (<profile>-dev: the same kernel
features, path-only attestation, the loader's development policy) and seals
it with throwaway keys, the ones CI's boot smoke makes. All of it happens in
a copy of this checkout under target/dev/tree, so the throwaway keys are made
there and only there, and the release keys beside a real checkout are never
read. The image is target/dev/tree/target/release/<profile>-dev/nonos.img;
`make dev-boot` boots it.

A development image is never a release: its gates take a capsule on its
Merkle path without the STARK proof, its loader carries the development
override, and the seal refuses to seal it for release.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TREE = ROOT / "target/dev/tree"
# Never copied: what a real checkout keeps beside the source.
KEEP_OUT = (".keys/", "nonos-bootloader/keys/", "target/", "result")


def sh(*cmd, cwd=TREE, env=None, capture=False):
    r = subprocess.run(cmd, cwd=cwd, env=dict(os.environ, **(env or {})), text=True,
                       capture_output=capture)
    if r.returncode != 0:
        sys.exit(f"nonos-dev-image: {' '.join(cmd[:3])} failed" + (f":\n{r.stderr}" if capture else ""))
    return r.stdout.strip() if capture else None


def tracked():
    """Every file the checkout holds as source, committed or not, ignored ones
    left out, so the copy builds what this tree would."""
    out = subprocess.run(["git", "ls-files", "-z", "-co", "--exclude-standard"], cwd=ROOT,
                         capture_output=True, check=True).stdout
    return [p for p in out.decode().split("\0") if p and not p.startswith(KEEP_OUT)]


def sync():
    """Bring the copy to this checkout: changed files copied, gone ones removed.
    The trust set is the copy's own once it exists: its throwaway keys and the
    seal's output live there, and the checkout's would not match them."""
    own_trust = (TREE / ".git").is_dir()
    want = set()
    for rel in tracked():
        if own_trust and rel.startswith("nonos-data/trust/"):
            continue
        src, dst = ROOT / rel, TREE / rel
        if not src.is_file() and not src.is_symlink():
            continue
        want.add(rel)
        if src.is_symlink():
            if dst.is_symlink() and os.readlink(dst) == os.readlink(src):
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            if dst.exists() or dst.is_symlink():
                dst.unlink()
            os.symlink(os.readlink(src), dst)
            continue
        s = src.stat()
        if dst.is_file() and not dst.is_symlink():
            d = dst.stat()
            if d.st_size == s.st_size and int(d.st_mtime) == int(s.st_mtime):
                continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
    if (TREE / ".git").is_dir():
        held = sh("git", "ls-files", "-z", capture=True).split("\0")
        for rel in held:
            if rel and rel not in want and not rel.startswith(("nonos-data/", ".keys/")):
                (TREE / rel).unlink(missing_ok=True)


def commit():
    """The copy is its own repository, so the seal can stage what it writes and
    the flake can build it, with no history of the real one."""
    git = ["git", "-c", "user.name=nonos-dev", "-c", "user.email=dev@localhost"]
    if not (TREE / ".git").is_dir():
        sh("git", "init", "-q")
    sh("git", "add", "-A")
    # What the checkout tracks against its own ignore rules (.cargo/config.toml
    # is one), added by name, so the copy holds exactly the same source.
    files = "\0".join(tracked()).encode()
    r = subprocess.run(["git", "add", "-f", "--pathspec-from-file=-", "--pathspec-file-nul"],
                       cwd=TREE, input=files)
    if r.returncode != 0:
        sys.exit("nonos-dev-image: git add of the tracked files failed")
    if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=TREE).returncode != 0:
        sh(*git, "commit", "-q", "--no-gpg-sign", "-m", "development image source")


def keys(host_tools):
    """CI's throwaway keys, made in the copy. Never a real key."""
    if not (TREE / ".keys/signing_key_v1.bin").is_file():
        print("nonos-dev-image: making throwaway keys in target/dev/tree, as CI does")
        sh("bash", "nonos-ci/setup-signing-key.sh")
    # Every build, not only the first: a capsule added to the tree since the
    # copy's keys were made needs its own, or the seal stops at it. The script
    # makes the publishers' keys afresh each time and keeps the device policy
    # key once made, so an image sealed again opens the data volume an earlier
    # one made, as a release does.
    sh("nix", "develop", "--command", "bash", "nonos-ci/scratch-trust-bootstrap.sh",
       env={"NONOS_HOST_TOOLS": host_tools, "NONOS_SCRATCH_KEYS_ONLY": "1"})
    # The market capsule embeds the market operator's public key, and the seal
    # signs the market index and the model catalogue with it; CI's set has
    # none, so the copy gets a throwaway one of its own.
    seed = TREE / ".keys/marketplace_operator_ed25519.seed"
    pub = TREE / ".keys/marketplace_operator_ed25519.pub"
    # The operator's public key is the raw 32 bytes, as the market tools read
    # it; a pair in any other shape is made again.
    if not (seed.is_file() and pub.is_file() and pub.stat().st_size == 32):
        seed.unlink(missing_ok=True)
        pub.unlink(missing_ok=True)
        out = sh(f"{host_tools}/bin/marketplace-index", "keygen", "--out", str(seed), capture=True)
        pub.write_bytes(bytes.fromhex(out.split()[-1]))
    # The checkout tracks its operator's public key here; the copy tracks the
    # throwaway one instead, so the flake builds the capsule against the key
    # that signs this image's index.
    sh("git", "add", "-f", ".keys/marketplace_operator_ed25519.pub")
    commit()


# The kernel serves the SimpleX window's core its one listener only for a run
# bound to the core's listing key, pinned in serves.rs as that listing's key
# under the operator that signs the catalogue. The copy's catalogue is signed
# under its throwaway operator, so its guest policy names another key, and
# every listen the window's core made was refused: the window said the core
# did not start. The copy pins its own operator's key; the checkout's stays.
SERVES = "src/services/registry/serves.rs"
SERVES_CONST = re.compile(r"(const SIMPLEX_CORE: \[u8; 32\] = \[\n)(.*?)(\n\];)", re.S)
SERVES_LISTING = re.compile(r'\("app\.simplex", "(linux\.[a-z0-9.-]+)"\)')


def serves_text(text, operator):
    """serves.rs's text with SIMPLEX_CORE the key of the listing LISTINGS
    pairs the window with, under the 32-byte `operator`; None when the text
    has not exactly one of each, or the key is not 32 bytes."""
    sys.path.insert(0, str(ROOT / "tools"))
    from nonos_linux_pack.policy import listing_id

    consts, listings = SERVES_CONST.findall(text), SERVES_LISTING.findall(text)
    if len(consts) != 1 or len(listings) != 1 or len(operator) != 32:
        return None
    key = listing_id(operator, listings[0])
    rows = [", ".join(f"0x{b:02x}" for b in key[i:i + 16]) + "," for i in (0, 16)]
    body = "\n".join("    " + r for r in rows)
    return SERVES_CONST.sub(lambda m: m.group(1) + body + m.group(3), text)


def pin_serves():
    """The copy's kernel pairs the SimpleX window with its core's listing as
    the copy's catalogue keys it; the copy only."""
    path = TREE / SERVES
    operator = (TREE / ".keys/marketplace_operator_ed25519.pub").read_bytes()
    was = path.read_text()
    text = serves_text(was, operator)
    if text is None:
        sys.exit(f"nonos-dev-image: {SERVES} has no one SIMPLEX_CORE and app.simplex listing to pin")
    if text != was:
        path.write_text(text)
        commit()


def selftest_panic():
    """The selftest image's capsule_linux is built with selftest-panic, so its
    boot shows the Terminal's answer to a panic inside a box. Only here, in
    the copy's capsules.json, for this profile: the next build of any other
    profile copies the checkout's file back, and scripts/check_copy_only_features.py
    fails any committed build that names the feature."""
    path = TREE / "tools/nix/capsules.json"
    path.write_text(json.dumps(panicking(json.loads(path.read_text())), indent=1) + "\n")
    commit()


def panicking(entries):
    """capsules.json's entries with selftest-panic added to capsule_linux's
    cargo_features, keeping any it already has (scripts/selftest_panic_fixture.py)."""
    for e in entries:
        if e["slug"] == "linux":
            have = [f for f in e["cargo_features"].split(",") if f]
            e["cargo_features"] = ",".join(have + ["selftest-panic"] * ("selftest-panic" not in have))
    return entries


def with_features(text, names):
    """nonos.toml's text with each of `names` on its features line, once, or
    None if it has no features line."""
    m = re.search(r"^features = \[(.*)\]$", text, flags=re.M)
    if not m:
        return None
    have = [f for f in m.group(1).split(", ") if f]
    have += [f'"{n}"' for n in names if f'"{n}"' not in have]
    return text[:m.start()] + "features = [" + ", ".join(have) + "]" + text[m.end():]


def add_features(names, what):
    """`names` added to the copy's nonos.toml features, the copy only."""
    toml = TREE / "nonos.toml"
    text = with_features(toml.read_text(), names)
    if text is None:
        sys.exit(f"nonos-dev-image: nonos.toml has no features line to add {what} to")
    toml.write_text(text)


# The nsh host capsules, and where the machine's development records and the
# client files that pair with them are written: outside the copy, since the
# image carries no identity. The machine makes its own host keys at its first
# boot and writes its enrolment request under /nonos/nsh; nsh-devkit, given
# that request, writes the enrolment beside the records.
NSH_FEATURES = ("nonos-capsule-nsh-front", "nonos-capsule-nsh-attest")
NSH_RECORDS = ROOT / "target/dev/nsh-records"
NSH_CLIENT = ROOT / "target/dev/nsh-client"


def devkit_args(request=None, loader=None):
    """nsh-devkit's arguments: the machine's records and the client files,
    from keys one run makes afresh, so the two pair; with `request`, the
    directory holding the machine's host.public and enrol.doc, and `loader`,
    the enrolment for that machine too."""
    out = [str(NSH_RECORDS), str(NSH_CLIENT)]
    if request is None:
        return out
    req = Path(request).resolve()
    return ["enrol", *out, str(req / "host.public"), str(req / "enrol.doc"), loader]


def nsh(on, request=None, loader=None):
    """With `on`, nsh.front and nsh.attest in the copy's kernel, and the
    devkit's throwaway records and client files (userland/nsh_server_proofs,
    nsh-devkit) beside the copy, never in it. Nothing is baked into the
    image: the capsules build from committed files alone."""
    if not on:
        return
    add_features(NSH_FEATURES, "the nsh capsules")
    commit()
    devkit = ["cargo", "run", "-q", "--manifest-path", str(ROOT / "userland/nsh_server_proofs/Cargo.toml"),
              "--bin", "nsh-devkit", "--"]
    sh(*devkit, *devkit_args(request, loader), cwd=ROOT)
    print(f"nonos-dev-image: nsh records in {NSH_RECORDS.relative_to(ROOT)}, "
          f"client files in {NSH_CLIENT.relative_to(ROOT)}")


def bringup_trace():
    """The bring-up trace image: the kernel
    built with nonos-bringup-trace and capsule_acpi with bringup-trace, both in
    the copy only; scripts/check_copy_only_features.py keeps the capsule's out
    of every committed build."""
    add_features(["nonos-bringup-trace"], "the trace")
    path = TREE / "tools/nix/capsules.json"
    entries = json.loads(path.read_text())
    for e in entries:
        if e["slug"] == "acpi":
            have = [f for f in e["cargo_features"].split(",") if f]
            e["cargo_features"] = ",".join(have + ["bringup-trace"] * ("bringup-trace" not in have))
    path.write_text(json.dumps(entries, indent=1) + "\n")
    commit()


def agentproof_job(job_dir):
    """The copy's Terminal built headless, running the job in `job_dir`
    (tools/agentproof_gauntlet/image.py): a Gauntlet image, never a release."""
    sys.path.insert(0, str(ROOT / "tools"))
    from agentproof_gauntlet.image import place
    place(TREE, job_dir)
    commit()


# A nonos.toml top-level `KEY = VALUE` line, and the one error the setters raise.
KEY = re.compile(r"^([a-z_]+)\s*=")


class ImageError(RuntimeError):
    pass


def set_keys(text, settings):
    """`text`, a nonos.toml, with each top-level KEY = VALUE line in `settings`
    replaced; an error for a key it does not have before its first table."""
    lines, done = text.splitlines(keepends=True), set()
    for i, line in enumerate(lines):
        if line.startswith("["):
            break
        m = KEY.match(line)
        if m and m.group(1) in settings:
            lines[i] = f"{m.group(1)} = {settings[m.group(1)]}\n"
            done.add(m.group(1))
    missing = set(settings) - done
    if missing:
        raise ImageError(f"nonos.toml has no top-level {', '.join(sorted(missing))}")
    return "".join(lines)


# What --offline blanks in the copy's nonos.toml: no package mirror and no
# source recipes.
OFFLINE = {"linux_packages": '""', "linux_sources": '""'}


def offline(text):
    """nonos.toml's text with no package mirror and no source recipes, or None
    if it lacks either key before its first table."""
    try:
        return set_keys(text, OFFLINE)
    except ImageError:
        return None


def go_offline():
    """The copy seals with no package mirror and no source recipes, so it
    builds where neither can be reached. Its Marketplace lists no Linux tool
    and no app built from source (DarkFi, SimpleX); the copy only."""
    toml = TREE / "nonos.toml"
    text = offline(toml.read_text())
    if text is None:
        sys.exit("nonos-dev-image: nonos.toml has no linux_packages or linux_sources line to clear")
    toml.write_text(text)
    commit()


# Where a development guest finds the NONOS package mirror with the mirror
# on: the host's relay, at the address QEMU's user network shows the host,
# as its Alpine packages are (docs/build/dev-mirror.md). The relay serves the
# seal's <out>/packages/ there (nonos-mirror-relay --content), each file only
# as the BLAKE3 its name pins, and the guest holds it to the market's pin.
RELAY = "10.0.2.2:8080"


def to_relay(text):
    """nonos.toml's text with its package mirror the host's relay; the text as
    it is when it names no mirror, as none is made up; None when set_keys
    finds no top-level line for it."""
    if not tomllib.loads(text).get("linux_packages", ""):
        return text
    try:
        return set_keys(text, {"linux_packages": f'"{RELAY}"'})
    except ImageError:
        return None


def go_relay():
    """The copy's guest fetches the package mirror's content from the host's
    relay: a mirror on the internet is reached only over Anyone, which a
    development guest under QEMU may have no way to. The copy only."""
    toml = TREE / "nonos.toml"
    was = toml.read_text()
    text = to_relay(was)
    if text is None:
        sys.exit("nonos-dev-image: nonos.toml's linux_packages is not a line to point at the relay")
    if text != was:
        toml.write_text(text)
        commit()


def linux_sources():
    """The source recipes' content in the copy's linux_sources, each held to
    its pin, from the cache, this checkout's content branch or upstream
    (tools/nonos_linux_sources): the copy has no remote of its own, so this
    runs here, and the copy's seal finds it present. A recipe nothing here
    gives is said and left out of the copy's catalogue, as a development
    build may; a release seal never leaves one out."""
    with open(TREE / "nonos.toml", "rb") as f:
        where = tomllib.load(f).get("linux_sources", "")
    if not where:
        return
    sys.path.insert(0, str(ROOT / "tools"))
    from nonos_linux_sources.ensure import ensure

    try:
        for package, came in ensure((TREE / where).resolve(), repo=ROOT, absent_ok=True):
            print(f"nonos-dev-image: {package} from {came}")
    except ValueError as why:
        sys.exit(f"nonos-dev-image: the source recipes' content: {why}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    ap.add_argument("--profile", default="qemu", help="the profile whose development twin to build")
    ap.add_argument("--keys-only", action="store_true",
                    help="bring the copy and its throwaway keys up to date, and seal nothing: for a make "
                         "lane run inside target/dev/tree, as tools/nonos-selftest does")
    ap.add_argument("--bringup-trace", action="store_true",
                    help="the bring-up trace: [BRINGUP] and the ACPI capsule's trace lines on serial")
    ap.add_argument("--nsh", action="store_true",
                    help="nsh.front and nsh.attest in the kernel, and the devkit's throwaway records "
                         "and client files beside the copy")
    ap.add_argument("--nsh-request", metavar="DIR",
                    help="with --nsh, enrol the machine whose host.public and enrol.doc are in DIR")
    ap.add_argument("--nsh-loader", metavar="HEX", help="with --nsh-request, the loader's PCR 4 digest")
    ap.add_argument("--offline", action="store_true",
                    help="no package mirror and no source recipes (DarkFi, SimpleX): for a machine "
                         "that cannot reach either; the Marketplace lists no Linux tool")
    ap.add_argument("--agentproof-job", metavar="DIR",
                    help="a Gauntlet image: the Terminal built headless, running the job in DIR")
    a = ap.parse_args()
    if (a.nsh_request is None) != (a.nsh_loader is None) or (a.nsh_request and not a.nsh):
        sys.exit("nonos-dev-image: --nsh-request and --nsh-loader go together, with --nsh")
    if a.agentproof_job and a.profile != "gauntlet":
        sys.exit("nonos-dev-image: --agentproof-job builds the gauntlet profile, whose apps start at boot")
    attr = "dev" if a.profile == "dev" else f"{a.profile}-dev"
    TREE.mkdir(parents=True, exist_ok=True)
    print(f"nonos-dev-image: {attr}, in {TREE.relative_to(ROOT)}")
    sync()
    commit()
    # host-tools mounts the market's key file, so a fresh copy holds the
    # checkout's tracked operator key, public by design, until keys() makes
    # the throwaway pair that replaces it.
    pub = TREE / ".keys/marketplace_operator_ed25519.pub"
    if not pub.is_file():
        pub.parent.mkdir(exist_ok=True)
        shutil.copy2(ROOT / ".keys/marketplace_operator_ed25519.pub", pub)
        sh("git", "add", "-f", ".keys/marketplace_operator_ed25519.pub")
        commit()
    host_tools = sh("nix", "build", ".#host-tools", "--no-link", "--print-out-paths", capture=True)
    keys(host_tools)
    pin_serves()
    if a.profile == "selftest":
        selftest_panic()
    if a.bringup_trace:
        bringup_trace()
    nsh(a.nsh, a.nsh_request, a.nsh_loader)
    if a.agentproof_job:
        agentproof_job(Path(a.agentproof_job).resolve())
    if a.offline:
        go_offline()
    else:
        go_relay()
    if a.keys_only:
        print(f"nonos-dev-image: {TREE.relative_to(ROOT)} and its throwaway keys are ready")
        return
    linux_sources()
    sh("nix", "run", ".#seal", "--", "--profile", attr,
       env={"SIGNING_KEY": str(TREE / ".keys/signing_key_v1.bin")})
    img = TREE / "target/release" / attr / "nonos.img"
    print(f"\nnonos-dev-image: {img.relative_to(ROOT)}")
    print("  boot it: make dev-boot" + ("" if a.profile == "qemu" else f" PROFILE={a.profile}"))
    if not a.offline:
        out = (TREE / "target/release" / attr / "packages").relative_to(ROOT)
        print(f"  its mirror: tools/nonos-mirror-relay --cache target/mirror-cache --content {out}")


if __name__ == "__main__":
    main()
