queue, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.OffsetsQueue

open Aeneas Aeneas.Std Result
open nonos_x_offsets_queue

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.OffsetsQueue

/-! ### The forwarding functions add nothing -/

theorem the_iqa_value_wrapper_is_its_method (a : Std.U64) :
    iqa_value a = queue.iqa_value a := rfl

theorem the_queue_offset_wrapper_is_its_method (a : Std.U16) :
    queue_offset a = queue.queue_offset a := rfl

theorem the_queue_index_wrapper_is_its_method (a : Std.U64) :
    queue_index a = queue.queue_index a := rfl

theorem the_queue_next_wrapper_is_its_method (a : Std.U16) :
    queue_next a = queue.queue_next a := rfl

theorem the_queue_free_wrapper_is_its_method (a : Std.U16) (b : Std.U16) :
    queue_free a b = queue.queue_free a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.OffsetsQueue.the_iqa_value_wrapper_is_its_method
#print axioms NonosExtraction.OffsetsQueue.the_queue_offset_wrapper_is_its_method
#print axioms NonosExtraction.OffsetsQueue.the_queue_index_wrapper_is_its_method
#print axioms NonosExtraction.OffsetsQueue.the_queue_next_wrapper_is_its_method
#print axioms NonosExtraction.OffsetsQueue.the_queue_free_wrapper_is_its_method

end NonosExtraction.OffsetsQueue
