srat_memory, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.TablesSratMemory

open Aeneas Aeneas.Std Result
open nonos_x_tables_srat_memory

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.TablesSratMemory

/-! ### The forwarding functions add nothing -/

theorem the_sratmemoryaffinity_is_enabled_wrapper_is_its_method (a : srat_memory.SratMemoryAffinity) :
    sratmemoryaffinity_is_enabled a = srat_memory.SratMemoryAffinity.is_enabled a := rfl

theorem the_sratmemoryaffinity_is_hot_pluggable_wrapper_is_its_method (a : srat_memory.SratMemoryAffinity) :
    sratmemoryaffinity_is_hot_pluggable a = srat_memory.SratMemoryAffinity.is_hot_pluggable a := rfl

theorem the_sratmemoryaffinity_is_non_volatile_wrapper_is_its_method (a : srat_memory.SratMemoryAffinity) :
    sratmemoryaffinity_is_non_volatile a = srat_memory.SratMemoryAffinity.is_non_volatile a := rfl

theorem the_sratmemoryaffinity_end_address_wrapper_is_its_method (a : srat_memory.SratMemoryAffinity) :
    sratmemoryaffinity_end_address a = srat_memory.SratMemoryAffinity.end_address a := rfl

theorem the_sratmemoryaffinity_contains_address_wrapper_is_its_method (a : srat_memory.SratMemoryAffinity) (b : Std.U64) :
    sratmemoryaffinity_contains_address a b = srat_memory.SratMemoryAffinity.contains_address a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.TablesSratMemory.the_sratmemoryaffinity_is_enabled_wrapper_is_its_method
#print axioms NonosExtraction.TablesSratMemory.the_sratmemoryaffinity_is_hot_pluggable_wrapper_is_its_method
#print axioms NonosExtraction.TablesSratMemory.the_sratmemoryaffinity_is_non_volatile_wrapper_is_its_method
#print axioms NonosExtraction.TablesSratMemory.the_sratmemoryaffinity_end_address_wrapper_is_its_method
#print axioms NonosExtraction.TablesSratMemory.the_sratmemoryaffinity_contains_address_wrapper_is_its_method

end NonosExtraction.TablesSratMemory
