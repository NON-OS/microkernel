/-! ### The forwarding functions add nothing -/

theorem the_portrange_new_wrapper_is_its_method (a : Std.U16) (b : Std.U16) :
    portrange_new a b = range.PortRange.new a b := rfl

theorem the_portrange_start_wrapper_is_its_method (a : range.PortRange) :
    portrange_start a = range.PortRange.impl.start a := rfl

theorem the_portrange_count_wrapper_is_its_method (a : range.PortRange) :
    portrange_count a = range.PortRange.impl.count a := rfl

theorem the_portrange_end_wrapper_is_its_method (a : range.PortRange) :
    portrange_end a = range.PortRange.end a := rfl

theorem the_portrange_contains_wrapper_is_its_method (a : range.PortRange) (b : Std.U16) :
    portrange_contains a b = range.PortRange.contains a b := rfl

theorem the_portrange_overlaps_wrapper_is_its_method (a : range.PortRange) (b : range.PortRange) :
    portrange_overlaps a b = range.PortRange.overlaps a b := rfl

/-! ### What a port range covers

    A `PortRange` is a start port and a count. `end` is the start plus the count,
    saturated at `0xFFFF` rather than wrapped. `contains` is `start <= port` and
    `port - start < count`, and `overlaps` compares the two true ends in 32-bit
    arithmetic. The theorems below fix that arithmetic exactly: the accessors
    return what the constructor was given, `end` is the saturated sum,
    `contains` holds precisely on `start` up to `start + count` for every range,
    and two ranges overlap exactly when some port lies in both.
    `PortManager::reserve_range` refuses a range that overlaps a reserved one,
    and `is_reserved` tests membership.

    Both tests used to compare with the saturated `end`. Because `end` never
    exceeds `0xFFFF` and the test was strict, port `0xFFFF` was in no range, so
    `reserve_range(0xFFFF, 1)` stored a range `is_reserved(0xFFFF)` did not see
    and that overlapped nothing, and it could be reserved again.
    `port_0xffff_is_in_the_range_that_reaches_it` and
    `ranges_reaching_the_top_overlap_there` are those cases now; `kernel_proofs`
    keeps a test of them against the kernel source.

    These theorems are about `PortRange` alone. The reservation table that holds
    ranges sits behind an `RwLock` in a static, which is not extracted, so what the
    manager does with a range is argued from its source and not proven here.
-/

/-- The accessors return what the constructor stored, in the right fields. -/
theorem portrange_start_and_portrange_count_return_what_portrange_new_was_given
    (s c : Std.U16) :
    (do let r ← portrange_new s c; portrange_start r) = ok s ∧
    (do let r ← portrange_new s c; portrange_count r) = ok c := ⟨rfl, rfl⟩

private theorem u16_saturating_add_val (a b : Std.U16) :
    (core.num.U16.saturating_add a b).val = min (a.val + b.val) 65535 := by
  simp only [core.num.U16.saturating_add, UScalar.saturating_add,
    UScalar.max_UScalarTy_U16_eq, U16.max, UScalar.val, BitVec.toNat_ofNat, U16.numBits]
  have := a.hBounds; have := b.hBounds
  simp only [UScalar.val, UScalarTy.numBits] at *
  omega

private theorem sub_ok {ty : UScalarTy} (x y : UScalar ty) (h : y.val ≤ x.val) :
    ∃ z : UScalar ty, x - y = ok z ∧ z.val = x.val - y.val := by
  have e := UScalar.sub_equiv x y
  cases hr : (x - y : Result (UScalar ty)) with
  | ok z => rw [hr] at e; exact ⟨z, rfl, by omega⟩
  | fail _ => rw [hr] at e; simp at e; omega
  | div => rw [hr] at e; exact e.elim

private theorem add_ok {ty : UScalarTy} (x y : UScalar ty) (h : x.val + y.val < 2 ^ ty.numBits) :
    ∃ z : UScalar ty, x + y = ok z ∧ z.val = x.val + y.val := by
  have e := UScalar.add_equiv x y
  cases hr : (x + y : Result (UScalar ty)) with
  | ok z => rw [hr] at e; exact ⟨z, rfl, e.2.1⟩
  | fail _ =>
    rw [hr] at e
    exact absurd (by simp [UScalar.inBounds]; omega) e
  | div => rw [hr] at e; exact e.elim

/-- `end` is the start plus the count, clamped at the largest port. -/
theorem portrange_end_is_the_saturated_sum (p : range.PortRange) :
    ∃ e, portrange_end p = ok e ∧ e.val = min (p.start.val + p.count.val) 65535 :=
  ⟨_, rfl, u16_saturating_add_val _ _⟩

/-- At the top of the port space `end` clamps instead of wrapping: sixteen ports
    from `0xFFF0` end at `0xFFFF`, not at `0`. -/
theorem portrange_end_clamps_rather_than_wraps :
    portrange_end ⟨0xFFF0#u16, 16#u16⟩ = ok 0xFFFF#u16 := by
  obtain ⟨e, he, hv⟩ := portrange_end_is_the_saturated_sum ⟨0xFFF0#u16, 16#u16⟩
  rw [he]
  congr 1
  apply UScalar.eq_of_val_eq
  rw [hv]
  rfl

/-- For every range, `contains` is exactly `start <= port < start + count`: the
    count ports from the start and no others, with no clamp at the top. -/
theorem portrange_contains_is_start_to_start_plus_count (p : range.PortRange) (port : Std.U16) :
    portrange_contains p port =
      ok (decide (p.start.val ≤ port.val ∧ port.val < p.start.val + p.count.val)) := by
  unfold portrange_contains range.PortRange.contains
  by_cases hs : p.start.val ≤ port.val
  · have : port ≥ p.start := hs
    obtain ⟨z, hz, hv⟩ := sub_ok port p.start hs
    simp only [this, if_true, hz, bind_tc_ok]
    congr 1
    simp only [decide_eq_decide, hs, true_and]
    show z.val < p.count.val ↔ _
    omega
  · have : ¬ port ≥ p.start := hs
    simp only [this, if_false, hs, false_and, decide_false]

/-- The same statement through the constructor. -/
theorem portrange_new_then_contains_is_start_to_start_plus_count (s c port : Std.U16) :
    (do let r ← portrange_new s c; portrange_contains r port) =
      ok (decide (s.val ≤ port.val ∧ port.val < s.val + c.val)) :=
  portrange_contains_is_start_to_start_plus_count ⟨s, c⟩ port

/-- `overlaps` never fails and compares the true ends: each range starts before
    the other one ends. -/
theorem portrange_overlaps_compares_the_true_ends (p q : range.PortRange) :
    portrange_overlaps p q =
      ok (decide (p.start.val < q.start.val + q.count.val ∧
        q.start.val < p.start.val + p.count.val)) := by
  unfold portrange_overlaps range.PortRange.overlaps
  have h1 := p.start.hBounds; have h2 := p.count.hBounds
  have h3 := q.start.hBounds; have h4 := q.count.hBounds
  simp only [UScalarTy.U16_numBits_eq] at h1 h2 h3 h4
  simp only [lift, bind_tc_ok]
  obtain ⟨i1, hi1, v1⟩ := add_ok (UScalar.cast .U32 q.start) (UScalar.cast .U32 q.count)
    (by simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq]; omega)
  rw [hi1]; simp only [bind_tc_ok]
  simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq] at v1
  rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at v1
  by_cases ha : p.start.val < q.start.val + q.count.val
  · have : UScalar.cast .U32 p.start < i1 := by
      show (UScalar.cast .U32 p.start).val < i1.val
      simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq]
      rw [Nat.mod_eq_of_lt (by omega)]; omega
    simp only [this, if_true]
    obtain ⟨i3, hi3, v3⟩ := add_ok (UScalar.cast .U32 p.start) (UScalar.cast .U32 p.count)
      (by simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq]; omega)
    rw [hi3]; simp only [bind_tc_ok]
    simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq] at v3
    rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at v3
    congr 1
    simp only [decide_eq_decide, ha, true_and]
    show (UScalar.cast .U32 q.start).val < i3.val ↔ _
    simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq]
    rw [Nat.mod_eq_of_lt (by omega)]; omega
  · have : ¬ UScalar.cast .U32 p.start < i1 := by
      show ¬ (UScalar.cast .U32 p.start).val < i1.val
      simp only [UScalar.cast_val_eq, UScalarTy.U32_numBits_eq]
      rw [Nat.mod_eq_of_lt (by omega)]; omega
    simp only [this, if_false, ha, false_and, decide_false]

/-- Two non-empty ranges overlap exactly when some port lies in both, so
    `reserve_range` refuses a non-empty range precisely when it would share a
    port with a reserved one. An empty range has no ports but is still reported
    as overlapping any range that strictly contains its start, which only makes
    `reserve_range` refuse more. -/
theorem portrange_overlaps_exactly_when_a_port_is_in_both (p q : range.PortRange)
    (hp : p.count.val ≠ 0) (hq : q.count.val ≠ 0) :
    portrange_overlaps p q = ok true ↔
      ∃ port : Std.U16, portrange_contains p port = ok true ∧
        portrange_contains q port = ok true := by
  simp only [portrange_overlaps_compares_the_true_ends,
    portrange_contains_is_start_to_start_plus_count, ok.injEq, decide_eq_true_eq]
  have h1 := p.start.hBounds; have h3 := q.start.hBounds
  simp only [UScalarTy.U16_numBits_eq] at h1 h3
  constructor
  · rintro ⟨ha, hb⟩
    have hm : (⟨BitVec.ofNat 16 (max p.start.val q.start.val)⟩ : Std.U16).val
        = max p.start.val q.start.val := by
      show (BitVec.ofNat 16 (max p.start.val q.start.val)).toNat = _
      rw [BitVec.toNat_ofNat]
      exact Nat.mod_eq_of_lt (by omega)
    refine ⟨⟨BitVec.ofNat 16 (max p.start.val q.start.val)⟩, ?_, ?_⟩ <;> rw [hm] <;> omega
  · rintro ⟨port, ⟨a1, a2⟩, ⟨b1, b2⟩⟩
    omega

/-- Port `0xFFFF` is in the one-port range that starts there and in the sixteen
    ports from `0xFFF0`; with the saturated end it was in neither. -/
theorem port_0xffff_is_in_the_range_that_reaches_it :
    portrange_contains ⟨0xFFFF#u16, 1#u16⟩ 0xFFFF#u16 = ok true ∧
      portrange_contains ⟨0xFFF0#u16, 16#u16⟩ 0xFFFF#u16 = ok true := by
  simp only [portrange_contains_is_start_to_start_plus_count]
  exact ⟨rfl, rfl⟩

/-- Sixteen ports from `0xFFF0` and the one port at `0xFFFF` overlap, so the
    second reservation is refused. With the saturated end they did not. -/
theorem ranges_reaching_the_top_overlap_there :
    portrange_overlaps ⟨0xFFF0#u16, 16#u16⟩ ⟨0xFFFF#u16, 1#u16⟩ = ok true := by
  rw [portrange_overlaps_compares_the_true_ends]
  rfl

/-- An empty range contains no port. -/
theorem an_empty_portrange_holds_nothing (s port : Std.U16) :
    portrange_contains ⟨s, 0#u16⟩ port = ok false := by
  rw [portrange_contains_is_start_to_start_plus_count]
  have : (0#u16 : Std.U16).val = 0 := rfl
  congr 1; simp only [this]; simp

