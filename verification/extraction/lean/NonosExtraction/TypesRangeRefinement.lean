range, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.TypesRange

open Aeneas Aeneas.Std Result
open nonos_x_types_range

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.TypesRange

/-! ### The forwarding functions add nothing -/

theorem the_portrange_new_wrapper_is_its_method (a : Std.U16) (b : Std.U16) :
    portrange_new a b = range.PortRange.new a b := rfl

theorem the_portrange_start_wrapper_is_its_method (a : range.PortRange) :
    portrange_start a = range.PortRange.impl.start a := rfl

theorem the_portrange_count_wrapper_is_its_method (a : range.PortRange) :
    portrange_count a = range.PortRange.impl.count a := rfl

theorem the_portrange_end_wrapper_is_its_method (a : range.PortRange) :
    portrange_end a = range.PortRange.end a := rfl

theorem the_portrange_contains_wrapper_is_its_method (a : range.PortRange) (b : Std.U16) :
    portrange_contains a b = range.PortRange.contains a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.TypesRange.the_portrange_new_wrapper_is_its_method
#print axioms NonosExtraction.TypesRange.the_portrange_start_wrapper_is_its_method
#print axioms NonosExtraction.TypesRange.the_portrange_count_wrapper_is_its_method
#print axioms NonosExtraction.TypesRange.the_portrange_end_wrapper_is_its_method
#print axioms NonosExtraction.TypesRange.the_portrange_contains_wrapper_is_its_method

end NonosExtraction.TypesRange
