import NonosExtraction.AcpiTablesSlitNeighbors

open Aeneas Aeneas.Std Result
open nonos_x_acpi_tables_slit_neighbors

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.AcpiTablesSlitNeighbors

/-! ### The forwarding functions add nothing -/

theorem the_numadistances_is_reachable_wrapper_is_its_method (a : arch.x86_64.acpi.tables.slit.numa.NumaDistances) (b : Std.Usize) (c : Std.Usize) :
    numadistances_is_reachable a b c = arch.x86_64.acpi.tables.slit.neighbors.NumaDistances.is_reachable a b c := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.AcpiTablesSlitNeighbors.the_numadistances_is_reachable_wrapper_is_its_method

end NonosExtraction.AcpiTablesSlitNeighbors
