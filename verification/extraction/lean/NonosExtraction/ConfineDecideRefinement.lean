decide, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ConfineDecide

open Aeneas Aeneas.Std Result
open nonos_x_confine_decide

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ConfineDecide

/-! ### The forwarding functions add nothing -/

theorem the_opted_in_wrapper_is_its_method (a : Bool) (b : Bool) :
    opted_in a b = decide.opted_in a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ConfineDecide.the_opted_in_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `opted_in` is `opt_in && !production`. -/
theorem opted_in_spec (o p : Bool) : opted_in o p = ok (o && !p) := by
  cases o <;> cases p <;> rfl

/-- **No unconfined DMA in a production image.** The development opt-in that
    lets a PCI device reach memory without an IOMMU domain is refused in a
    production build, whatever the opt-in says. -/
theorem production_never_opts_in (o : Bool) : opted_in o true = ok false := by
  cases o <;> rfl

#print axioms NonosExtraction.ConfineDecide.opted_in_spec
#print axioms NonosExtraction.ConfineDecide.production_never_opts_in

end NonosExtraction.ConfineDecide
