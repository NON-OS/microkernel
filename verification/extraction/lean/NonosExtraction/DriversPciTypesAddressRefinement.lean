address, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.DriversPciTypesAddress

open Aeneas Aeneas.Std Result
open nonos_x_drivers_pci_types_address

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.DriversPciTypesAddress

/-! ### The forwarding functions add nothing -/

theorem the_pciaddress_new_wrapper_is_its_method (a : Std.U8) (b : Std.U8) (c : Std.U8) :
    pciaddress_new a b c = drivers.pci.types.address.PciAddress.new a b c := rfl

theorem the_pciaddress_from_bdf_wrapper_is_its_method (a : Std.U16) :
    pciaddress_from_bdf a = drivers.pci.types.address.PciAddress.from_bdf a := rfl

theorem the_pciaddress_to_bdf_wrapper_is_its_method (a : drivers.pci.types.address.PciAddress) :
    pciaddress_to_bdf a = drivers.pci.types.address.PciAddress.to_bdf a := rfl

theorem the_pciaddress_config_address_wrapper_is_its_method (a : drivers.pci.types.address.PciAddress) (b : Std.U8) :
    pciaddress_config_address a b = drivers.pci.types.address.PciAddress.config_address a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.DriversPciTypesAddress.the_pciaddress_new_wrapper_is_its_method
#print axioms NonosExtraction.DriversPciTypesAddress.the_pciaddress_from_bdf_wrapper_is_its_method
#print axioms NonosExtraction.DriversPciTypesAddress.the_pciaddress_to_bdf_wrapper_is_its_method
#print axioms NonosExtraction.DriversPciTypesAddress.the_pciaddress_config_address_wrapper_is_its_method

end NonosExtraction.DriversPciTypesAddress
