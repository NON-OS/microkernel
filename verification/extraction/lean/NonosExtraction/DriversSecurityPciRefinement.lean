pci, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.DriversSecurityPci

open Aeneas Aeneas.Std Result
open nonos_x_drivers_security_pci

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.DriversSecurityPci

/-! ### The forwarding functions add nothing -/

theorem the_is_config_write_allowed_wrapper_is_its_method (a : Std.U8) :
    is_config_write_allowed a = drivers.security.pci.is_config_write_allowed a := rfl

theorem the_is_sensitive_config_read_wrapper_is_its_method (a : Std.U8) :
    is_sensitive_config_read a = drivers.security.pci.is_sensitive_config_read a := rfl

theorem the_build_config_address_wrapper_is_its_method (a : Std.U8) (b : Std.U8) (c : Std.U8) (d : Std.U8) :
    build_config_address a b c d = drivers.security.pci.build_config_address a b c d := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.DriversSecurityPci.the_is_config_write_allowed_wrapper_is_its_method
#print axioms NonosExtraction.DriversSecurityPci.the_is_sensitive_config_read_wrapper_is_its_method
#print axioms NonosExtraction.DriversSecurityPci.the_build_config_address_wrapper_is_its_method

end NonosExtraction.DriversSecurityPci
