pio_absent, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.HardwareBrokerPioAbsent

open Aeneas Aeneas.Std Result
open nonos_x_hardware_broker_pio_absent

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.HardwareBrokerPioAbsent

/-! ### The forwarding functions add nothing -/

theorem the_pio_release_all_for_pid_wrapper_is_its_method (a : Std.U32) :
    pio_release_all_for_pid a = hardware.broker.pio_absent.pio_release_all_for_pid a := rfl

theorem the_pio_release_for_device_wrapper_is_its_method (a : Std.U32) (b : Std.U64) :
    pio_release_for_device a b = hardware.broker.pio_absent.pio_release_for_device a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.HardwareBrokerPioAbsent.the_pio_release_all_for_pid_wrapper_is_its_method
#print axioms NonosExtraction.HardwareBrokerPioAbsent.the_pio_release_for_device_wrapper_is_its_method

end NonosExtraction.HardwareBrokerPioAbsent
