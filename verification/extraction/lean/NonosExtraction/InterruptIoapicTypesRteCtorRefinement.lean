ctor, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.InterruptIoapicTypesRteCtor

open Aeneas Aeneas.Std Result
open nonos_x_interrupt_ioapic_types_rte_ctor

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.InterruptIoapicTypesRteCtor

/-! ### The forwarding functions add nothing -/

theorem the_rte_fixed_wrapper_is_its_method (a : Std.U8) (b : Std.U32) :
    rte_fixed a b = arch.x86_64.interrupt.ioapic.types_rte.ctor.Rte.fixed a b := rfl

theorem the_rte_nmi_wrapper_is_its_method (a : Std.U32) :
    rte_nmi a = arch.x86_64.interrupt.ioapic.types_rte.ctor.Rte.nmi a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.InterruptIoapicTypesRteCtor.the_rte_fixed_wrapper_is_its_method
#print axioms NonosExtraction.InterruptIoapicTypesRteCtor.the_rte_nmi_wrapper_is_its_method

end NonosExtraction.InterruptIoapicTypesRteCtor
