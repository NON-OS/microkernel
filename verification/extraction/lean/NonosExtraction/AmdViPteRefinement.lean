/-! ### What the code decides -/

private theorem and_within (x m : Std.U64) (i : Nat) (h : (x &&& m).val.testBit i = true) :
    m.val.testBit i = true := by
  rw [UScalar.val_and, Nat.testBit_and] at h
  cases hm : m.val.testBit i
  · rw [hm] at h; simp at h
  · rfl

/-- **A page-table entry's address never carries a flag bit.** Every bit of
    `address` is a bit of the address mask. -/
theorem address_within_mask (e r : Std.U64) (h : address e = ok r) (i : Nat)
    (hi : r.val.testBit i = true) : pte.ADDR_MASK.val.testBit i = true := by
  unfold address pte.address at h
  simp only [Result.ok.injEq] at h
  subst h
  exact and_within e _ i hi

/-- Reading the address twice reads the same address. -/
theorem address_idem (e r : Std.U64) (h : address e = ok r) : address r = ok r := by
  unfold address pte.address at *
  simp only [Result.ok.injEq] at h
  subst h
  congr 1
  apply UScalar.eq_of_val_eq
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [UScalar.val_and, Nat.testBit_and]
  cases e.val.testBit i <;> cases pte.ADDR_MASK.val.testBit i <;> rfl

#print axioms NonosExtraction.AmdViPte.address_within_mask
#print axioms NonosExtraction.AmdViPte.address_idem

end NonosExtraction.AmdViPte
