/-! ### The forwarding functions add nothing -/

theorem the_directory_wrapper_is_its_method (a : Std.U64) (b : Std.U8) :
    directory a b = pte.directory a b := rfl

theorem the_leaf_wrapper_is_its_method (a : Std.U64) (b : Bool) (c : Bool) :
    leaf a b c = pte.leaf a b c := rfl

theorem the_is_present_wrapper_is_its_method (a : Std.U64) :
    is_present a = pte.is_present a := rfl

theorem the_next_level_wrapper_is_its_method (a : Std.U64) :
    next_level a = pte.next_level a := rfl

theorem the_address_wrapper_is_its_method (a : Std.U64) :
    address a = pte.address a := rfl

theorem the_writable_wrapper_is_its_method (a : Std.U64) :
    writable a = pte.writable a := rfl

theorem the_index_wrapper_is_its_method (a : Std.U64) (b : Std.U8) :
    index a b = pte.index a b := rfl

theorem the_reach_wrapper_is_its_method (a : Std.U8) :
    reach a = pte.reach a := rfl

