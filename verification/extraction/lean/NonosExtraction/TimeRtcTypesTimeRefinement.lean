time, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.TimeRtcTypesTime

open Aeneas Aeneas.Std Result
open nonos_x_time_rtc_types_time

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.TimeRtcTypesTime

/-! ### The forwarding functions add nothing -/

theorem the_rtctime_new_wrapper_is_its_method (a : Std.U16) (b : Std.U8) (c : Std.U8) (d : Std.U8) (e : Std.U8) (f : Std.U8) :
    rtctime_new a b c d e f = arch.x86_64.time.rtc.types.time.RtcTime.new a b c d e f := rfl

theorem the_rtctime_to_unix_timestamp_wrapper_is_its_method (a : arch.x86_64.time.rtc.types.time.RtcTime) :
    rtctime_to_unix_timestamp a = arch.x86_64.time.rtc.types.time.RtcTime.to_unix_timestamp a := rfl

theorem the_rtctime_from_unix_timestamp_wrapper_is_its_method (a : Std.U64) :
    rtctime_from_unix_timestamp a = arch.x86_64.time.rtc.types.time.RtcTime.from_unix_timestamp a := rfl

theorem the_rtctime_calculate_day_of_week_wrapper_is_its_method (a : arch.x86_64.time.rtc.types.time.RtcTime) :
    rtctime_calculate_day_of_week a = arch.x86_64.time.rtc.types.time.RtcTime.calculate_day_of_week a := rfl

theorem the_rtctime_with_day_of_week_wrapper_is_its_method (a : arch.x86_64.time.rtc.types.time.RtcTime) :
    rtctime_with_day_of_week a = arch.x86_64.time.rtc.types.time.RtcTime.with_day_of_week a := rfl

theorem the_rtctime_is_leap_year_wrapper_is_its_method (a : arch.x86_64.time.rtc.types.time.RtcTime) :
    rtctime_is_leap_year a = arch.x86_64.time.rtc.types.time.RtcTime.is_leap_year a := rfl

theorem the_rtctime_day_of_year_wrapper_is_its_method (a : arch.x86_64.time.rtc.types.time.RtcTime) :
    rtctime_day_of_year a = arch.x86_64.time.rtc.types.time.RtcTime.day_of_year a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_new_wrapper_is_its_method
#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_to_unix_timestamp_wrapper_is_its_method
#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_from_unix_timestamp_wrapper_is_its_method
#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_calculate_day_of_week_wrapper_is_its_method
#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_with_day_of_week_wrapper_is_its_method
#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_is_leap_year_wrapper_is_its_method
#print axioms NonosExtraction.TimeRtcTypesTime.the_rtctime_day_of_year_wrapper_is_its_method

end NonosExtraction.TimeRtcTypesTime
