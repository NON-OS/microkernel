array, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.GptArray

open Aeneas Aeneas.Std Result
open nonos_x_gpt_array

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.GptArray

/-! ### The forwarding functions add nothing -/

theorem the_array_sectors_wrapper_is_its_method (a : Std.U32) (b : Std.U32) :
    array_sectors a b = array.array_sectors a b := rfl

theorem the_shaped_wrapper_is_its_method (a : Std.U32) (b : Std.U32) :
    shaped a b = array.shaped a b := rfl

theorem the_within_wrapper_is_its_method (a : Std.U64) (b : Std.U32) (c : Std.U32) (d : Std.U64) (e : Std.U64) :
    within a b c d e = array.within a b c d e := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.GptArray.the_array_sectors_wrapper_is_its_method
#print axioms NonosExtraction.GptArray.the_shaped_wrapper_is_its_method
#print axioms NonosExtraction.GptArray.the_within_wrapper_is_its_method

end NonosExtraction.GptArray
