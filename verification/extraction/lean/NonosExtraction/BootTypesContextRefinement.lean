types_context, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.BootTypesContext

open Aeneas Aeneas.Std Result
open nonos_x_boot_types_context

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.BootTypesContext

/-! ### The forwarding functions add nothing -/

theorem the_exceptioncontext_instruction_pointer_wrapper_is_its_method (a : types_context.ExceptionContext) :
    exceptioncontext_instruction_pointer a = types_context.ExceptionContext.instruction_pointer a := rfl

theorem the_exceptioncontext_stack_pointer_wrapper_is_its_method (a : types_context.ExceptionContext) :
    exceptioncontext_stack_pointer a = types_context.ExceptionContext.stack_pointer a := rfl

theorem the_exceptioncontext_code_segment_wrapper_is_its_method (a : types_context.ExceptionContext) :
    exceptioncontext_code_segment a = types_context.ExceptionContext.code_segment a := rfl

theorem the_exceptioncontext_is_user_mode_wrapper_is_its_method (a : types_context.ExceptionContext) :
    exceptioncontext_is_user_mode a = types_context.ExceptionContext.is_user_mode a := rfl

theorem the_exceptioncontext_is_kernel_mode_wrapper_is_its_method (a : types_context.ExceptionContext) :
    exceptioncontext_is_kernel_mode a = types_context.ExceptionContext.is_kernel_mode a := rfl

theorem the_exceptioncontext_has_error_code_wrapper_is_its_method (a : types_context.ExceptionContext) :
    exceptioncontext_has_error_code a = types_context.ExceptionContext.has_error_code a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.BootTypesContext.the_exceptioncontext_instruction_pointer_wrapper_is_its_method
#print axioms NonosExtraction.BootTypesContext.the_exceptioncontext_stack_pointer_wrapper_is_its_method
#print axioms NonosExtraction.BootTypesContext.the_exceptioncontext_code_segment_wrapper_is_its_method
#print axioms NonosExtraction.BootTypesContext.the_exceptioncontext_is_user_mode_wrapper_is_its_method
#print axioms NonosExtraction.BootTypesContext.the_exceptioncontext_is_kernel_mode_wrapper_is_its_method
#print axioms NonosExtraction.BootTypesContext.the_exceptioncontext_has_error_code_wrapper_is_its_method

end NonosExtraction.BootTypesContext
