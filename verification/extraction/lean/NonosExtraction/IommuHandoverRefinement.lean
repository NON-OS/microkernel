handover, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.IommuHandover

open Aeneas Aeneas.Std Result
open nonos_x_iommu_handover

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.IommuHandover

/-! ### The forwarding functions add nothing -/

theorem the_amd_stop_wrapper_is_its_method (a : Bool) (b : Bool) :
    amd_stop a b = handover.amd_stop a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.IommuHandover.the_amd_stop_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `amd_stop` is `backend || dev`. -/
theorem amd_stop_spec (b d : Bool) : amd_stop b d = ok (b || d) := by
  cases b <;> cases d <;> rfl

/-- Firmware's AMD-Vi tables are let go only when the kernel's own backend is
    live or the development posture says so: never with both off. -/
theorem amd_kept_without_backend : amd_stop false false = ok false := rfl

#print axioms NonosExtraction.IommuHandover.amd_stop_spec
#print axioms NonosExtraction.IommuHandover.amd_kept_without_backend

end NonosExtraction.IommuHandover
