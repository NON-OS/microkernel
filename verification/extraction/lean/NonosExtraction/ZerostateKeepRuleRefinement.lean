keep_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ZerostateKeepRule

open Aeneas Aeneas.Std Result
open nonos_x_zerostate_keep_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ZerostateKeepRule

/-! ### The forwarding functions add nothing -/

theorem the_after_wrapper_is_its_method (a : Bool) (b : Bool) :
    after a b = keep_rule.after a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ZerostateKeepRule.the_after_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `after` is `armed || granted`. -/
theorem after_spec (a g : Bool) : after a g = ok (a || g) := by
  cases a <;> cases g <;> rfl

/-- **Keeping never turns off within a boot.** Once armed it stays armed,
    whatever the next push says. -/
theorem armed_stays (g : Bool) : after true g = ok true := by
  cases g <;> rfl

#print axioms NonosExtraction.ZerostateKeepRule.after_spec
#print axioms NonosExtraction.ZerostateKeepRule.armed_stays

end NonosExtraction.ZerostateKeepRule
