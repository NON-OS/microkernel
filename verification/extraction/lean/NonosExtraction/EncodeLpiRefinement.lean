lpi, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.EncodeLpi

open Aeneas Aeneas.Std Result
open nonos_x_encode_lpi

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.EncodeLpi

/-! ### The forwarding functions add nothing -/

theorem the_config_wrapper_is_its_method (a : Bool) :
    config a = lpi.config a := rfl

theorem the_propbaser_wrapper_is_its_method (a : Std.U64) (b : Std.U32) (c : Bool) :
    propbaser a b c = lpi.propbaser a b c := rfl

theorem the_pendbaser_wrapper_is_its_method (a : Std.U64) (b : Bool) :
    pendbaser a b = lpi.pendbaser a b := rfl

theorem the_prop_bytes_wrapper_is_its_method (a : Std.U32) :
    prop_bytes a = lpi.prop_bytes a := rfl

theorem the_pend_bytes_wrapper_is_its_method (a : Std.U32) :
    pend_bytes a = lpi.pend_bytes a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.EncodeLpi.the_config_wrapper_is_its_method
#print axioms NonosExtraction.EncodeLpi.the_propbaser_wrapper_is_its_method
#print axioms NonosExtraction.EncodeLpi.the_pendbaser_wrapper_is_its_method
#print axioms NonosExtraction.EncodeLpi.the_prop_bytes_wrapper_is_its_method
#print axioms NonosExtraction.EncodeLpi.the_pend_bytes_wrapper_is_its_method

end NonosExtraction.EncodeLpi
