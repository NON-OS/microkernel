/-! ### A device address is a PCI requester or a platform stream

A `DeviceAddress` is either `Pci segment rid`, where `rid` is the PCI requester
id (`bus << 8 | device << 3 | function`), or `Stream sid`, a platform device's
SMMU StreamID from the device tree. `attach_device` and `detach_device` in the
x86_64 IOMMU backend take a PCI address apart with `bdf` and hand the bus,
device and function to `map_device` and `unmap_device`, which pick the context
entry that confines the device. The theorems below say exactly which bits `bdf`
returns from a requester id, that `pci` and `pci_in` build the requester id
from a bus, a device and a function with the device and function masked to
their fields (so the bus field holds the bus and nothing else), that `bdf` reads
back what `pci` was given whenever the device number fits in five bits and the
function in three, that a Stream address has no requester id and no bus, device
and function, and the values at the field edges. A reader that shifted by one
bit too few, or a constructor that placed the bus at bit 7, would send one
device's DMA through another device's translation.

An earlier version of this type was a raw `u32` with a `new` constructor that
accepted any sixteen-bit value and a `pci_*` reader per field. Both are gone:
`deviceaddress_new` is now the Stream constructor, and `deviceaddress_as_u32`
now returns the requester id of a PCI address, if any. The theorems about
`new` agreeing with `pci` below sixteen bits were about that old packing and no
longer have a subject. The backend functions `map_device` and `unmap_device` are
not in this crate, so what they do with the three numbers is not established
here.
-/

/-- A right shift of a 16-bit word by a constant below 16 succeeds and divides
    by that power of two. -/
private theorem shr_u16 (x : Std.U16) (k : Std.I32) (h0 : 0 ≤ k.val) (h1 : k.val < 16) :
    ∃ z : Std.U16, x >>> k = ok z ∧ z.val = x.val / 2 ^ k.toNat := by
  obtain ⟨z, hz, hv, -⟩ :=
    WP.spec_imp_exists (UScalar.ShiftRight_IScalar_spec x k h0 (by simpa using h1))
  exact ⟨z, hz, by rw [hv, Nat.shiftRight_eq_div_pow]⟩

/-- A left shift of a 16-bit word by a constant below 16 succeeds and multiplies
    by that power of two, modulo the word. -/
private theorem shl_u16 (x : Std.U16) (k : Std.I32) (h0 : 0 ≤ k.val) (h1 : k.val < 16) :
    ∃ z : Std.U16, x <<< k = ok z ∧ z.val = x.val * 2 ^ k.toNat % 2 ^ 16 := by
  obtain ⟨z, hz, hv, -⟩ :=
    WP.spec_imp_exists (UScalar.ShiftLeft_IScalar_spec x k (UScalar.size .U16) h0
      (by simpa using h1) rfl)
  exact ⟨z, hz, by rw [hv, Nat.shiftLeft_eq]; simp [U16.size, U16.numBits]⟩

/-- A PCI address reads back the three fields of its requester id: the bus is
    bits 8 to 15, the device bits 3 to 7 (five bits, so never above 31) and the
    function the low three bits (never above 7). The segment is not read. -/
theorem deviceaddress_bdf_of_a_pci_address_reads_the_requester_id (seg rid : Std.U16) :
    ∃ b d f : Std.U8,
      deviceaddress_pci_bus (iommu_device.DeviceAddress.Pci seg rid) = ok (some (b, d, f)) ∧
      b.val = rid.val / 256 ∧ d.val = rid.val / 8 % 32 ∧ f.val = rid.val % 8 := by
  unfold deviceaddress_pci_bus iommu_device.DeviceAddress.bdf
  have hr := rid.hBounds
  simp [UScalarTy.numBits] at hr
  obtain ⟨z1, hz1, hv1⟩ := shr_u16 rid 8#i32 (by decide) (by decide)
  obtain ⟨z2, hz2, hv2⟩ := shr_u16 rid 3#i32 (by decide) (by decide)
  simp only [hz1, hz2, bind_tc_ok, lift]
  refine ⟨_, _, _, rfl, ?_, ?_, ?_⟩
  · rw [UScalar.cast_val_eq, hv1]
    simp only [show (8#i32 : Std.I32).toNat = 8 from rfl, UScalarTy.numBits]
    omega
  · rw [UScalar.cast_val_eq, Bits.land_low_mask z2 31#u16 5 rfl, hv2]
    simp only [show (3#i32 : Std.I32).toNat = 3 from rfl, UScalarTy.numBits]
    omega
  · rw [UScalar.cast_val_eq, Bits.land_low_mask rid 7#u16 3 rfl]
    simp only [UScalarTy.numBits]
    omega

/-- The bus, device and function readers are the same reader. -/
theorem deviceaddress_pci_device_and_function_read_what_the_bus_reader_reads
    (a : iommu_device.DeviceAddress) :
    deviceaddress_pci_device a = deviceaddress_pci_bus a ∧
      deviceaddress_pci_function a = deviceaddress_pci_bus a := ⟨rfl, rfl⟩

/-- The exact requester id `pci_in` builds, for every input: the bus in bits 8
    to 15, the device reduced to five bits in bits 3 to 7 and the function
    reduced to three bits below them. The segment is kept as given. -/
theorem deviceaddress_pci_in_builds_the_requester_id (seg : Std.U16) (b d f : Std.U8) :
    ∃ rid : Std.U16,
      iommu_device.DeviceAddress.pci_in seg b d f = ok (iommu_device.DeviceAddress.Pci seg rid) ∧
      rid.val = b.val * 256 + d.val % 32 * 8 + f.val % 8 := by
  unfold iommu_device.DeviceAddress.pci_in
  have hb := b.hBounds
  have hd := d.hBounds
  have hf := f.hBounds
  simp [UScalarTy.numBits] at hb hd hf
  obtain ⟨z1, hz1, hv1⟩ := shl_u16 (UScalar.cast .U16 b) 8#i32 (by decide) (by decide)
  obtain ⟨z2, hz2, hv2⟩ :=
    shl_u16 (UScalar.cast .U16 d &&& 31#u16) 3#i32 (by decide) (by decide)
  simp only [lift, bind_tc_ok, hz1, hz2]
  refine ⟨_, rfl, ?_⟩
  simp only [show (8#i32 : Std.I32).toNat = 8 from rfl,
    show (3#i32 : Std.I32).toNat = 3 from rfl, UScalar.cast_val_eq] at hv1 hv2
  rw [Bits.land_low_mask _ 31#u16 5 rfl, UScalar.cast_val_eq] at hv2
  simp only [UScalarTy.numBits] at hv1 hv2
  rw [Nat.mod_eq_of_lt (by omega : b.val < 2 ^ 16)] at hv1
  rw [Nat.mod_eq_of_lt (by omega : d.val < 2 ^ 16)] at hv2
  rw [Nat.mod_eq_of_lt (by omega)] at hv1 hv2
  rw [UScalar.val_or, UScalar.val_or, hv1, hv2, Bits.land_low_mask _ 7#u16 3 rfl,
    UScalar.cast_val_eq]
  simp only [UScalarTy.numBits]
  rw [Nat.mod_eq_of_lt (by omega : f.val < 2 ^ 16)]
  have h1 : b.val * 2 ^ 8 ||| d.val % 2 ^ 5 * 2 ^ 3
      = b.val * 2 ^ 8 + d.val % 2 ^ 5 * 2 ^ 3 := by
    rw [← Nat.shiftLeft_eq b.val 8]
    exact (Nat.shiftLeft_add_eq_or_of_lt (by omega) _).symm
  have h2 : (b.val * 2 ^ 8 + d.val % 2 ^ 5 * 2 ^ 3) ||| f.val % 2 ^ 3
      = (b.val * 2 ^ 8 + d.val % 2 ^ 5 * 2 ^ 3) + f.val % 2 ^ 3 := by
    have : b.val * 2 ^ 8 + d.val % 2 ^ 5 * 2 ^ 3 = (b.val * 32 + d.val % 32) <<< 3 := by
      rw [Nat.shiftLeft_eq]; omega
    rw [this]
    exact (Nat.shiftLeft_add_eq_or_of_lt (by omega) _).symm
  rw [h1, h2]
  omega

/-- `pci` is `pci_in` in segment zero, so it builds the same requester id. -/
theorem deviceaddress_pci_builds_the_requester_id_in_segment_zero (b d f : Std.U8) :
    ∃ rid : Std.U16,
      deviceaddress_pci b d f = ok (iommu_device.DeviceAddress.Pci 0#u16 rid) ∧
      rid.val = b.val * 256 + d.val % 32 * 8 + f.val % 8 ∧ rid.val < 65536 := by
  unfold deviceaddress_pci iommu_device.DeviceAddress.pci
  obtain ⟨rid, h, hv⟩ := deviceaddress_pci_in_builds_the_requester_id 0#u16 b d f
  exact ⟨rid, h, hv, rid.hBounds.trans_le' (by simp [UScalarTy.numBits])⟩

/-- Whatever device and function numbers are passed, the address reads back the
    bus it was given and the device and function reduced to their fields. A
    device number of 32 or more cannot move the address onto another bus. -/
theorem deviceaddress_pci_keeps_the_bus_for_every_device_and_function (b d f : Std.U8) :
    ∃ a bus dev fn, deviceaddress_pci b d f = ok a ∧
      deviceaddress_pci_bus a = ok (some (bus, dev, fn)) ∧
      bus = b ∧ dev.val = d.val % 32 ∧ fn.val = f.val % 8 := by
  obtain ⟨rid, ha, hv, -⟩ := deviceaddress_pci_builds_the_requester_id_in_segment_zero b d f
  obtain ⟨bus, dev, fn, hb, hbv, hdv, hfv⟩ :=
    deviceaddress_bdf_of_a_pci_address_reads_the_requester_id 0#u16 rid
  have hbb := b.hBounds
  simp [UScalarTy.numBits] at hbb
  refine ⟨_, bus, dev, fn, ha, hb, ?_, ?_, ?_⟩
  · apply UScalar.eq_of_val_eq; omega
  · omega
  · omega

/-- The contract `attach_device` and `detach_device` rely on: an address built
    by `deviceaddress_pci` from a bus, a device below 32 and a function below 8
    gives back exactly that bus, device and function. -/
theorem deviceaddress_pci_then_bdf_recovers_bus_device_and_function (b d f : Std.U8)
    (hd : d.val < 32) (hf : f.val < 8) :
    ∃ a, deviceaddress_pci b d f = ok a ∧ deviceaddress_pci_bus a = ok (some (b, d, f)) := by
  obtain ⟨a, bus, dev, fn, ha, hb, hbus, hdev, hfn⟩ :=
    deviceaddress_pci_keeps_the_bus_for_every_device_and_function b d f
  have hdd : dev = d := UScalar.eq_of_val_eq (by omega)
  have hff : fn = f := UScalar.eq_of_val_eq (by omega)
  subst hbus hdd hff
  exact ⟨a, ha, hb⟩

/-- A PCI address keeps its requester id, and the constructor for a platform
    device keeps its StreamID. -/
theorem deviceaddress_as_u32_returns_the_requester_id_of_a_pci_address (seg rid : Std.U16) :
    deviceaddress_as_u32 (iommu_device.DeviceAddress.Pci seg rid) = ok (some rid) := rfl

/-- A Stream address has no requester id and no bus, device or function: the
    PCI readers answer `none`, so the PCI backend cannot be pointed at a
    platform device by mistake. `deviceaddress_new` builds exactly the Stream
    address for the StreamID it is given. -/
theorem a_stream_address_has_no_requester_id_and_no_bdf (sid : Std.U32) :
    deviceaddress_new sid = ok (iommu_device.DeviceAddress.Stream sid) ∧
      deviceaddress_as_u32 (iommu_device.DeviceAddress.Stream sid) = ok none ∧
      deviceaddress_pci_bus (iommu_device.DeviceAddress.Stream sid) = ok none ∧
      deviceaddress_pci_device (iommu_device.DeviceAddress.Stream sid) = ok none ∧
      deviceaddress_pci_function (iommu_device.DeviceAddress.Stream sid) = ok none :=
  ⟨rfl, rfl, rfl, rfl, rfl⟩

/-- Concrete edges. `0xFFFF` is bus 255, device 31, function 7; `0x0100` is bus
    1 alone, so the bus starts exactly at bit 8. A device of 32 is packed as
    device 0 on bus 0, not as bus 1, and a function of 9 is packed as function
    1. -/
theorem deviceaddress_readers_and_pci_at_the_field_edges :
    deviceaddress_pci_bus (iommu_device.DeviceAddress.Pci 0#u16 0xFFFF#u16)
        = ok (some (255#u8, 31#u8, 7#u8)) ∧
      deviceaddress_pci_bus (iommu_device.DeviceAddress.Pci 0#u16 0x0100#u16)
        = ok (some (1#u8, 0#u8, 0#u8)) ∧
      deviceaddress_pci 0#u8 32#u8 0#u8 = ok (iommu_device.DeviceAddress.Pci 0#u16 0#u16) ∧
      deviceaddress_pci 1#u8 0#u8 0#u8 = ok (iommu_device.DeviceAddress.Pci 0#u16 256#u16) ∧
      deviceaddress_pci 0#u8 0#u8 9#u8 = ok (iommu_device.DeviceAddress.Pci 0#u16 1#u16) ∧
      deviceaddress_pci 255#u8 31#u8 7#u8
        = ok (iommu_device.DeviceAddress.Pci 0#u16 0xFFFF#u16) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> rfl

