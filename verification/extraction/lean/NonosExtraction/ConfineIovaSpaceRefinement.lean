iova_space, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ConfineIovaSpace
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_confine_iova_space

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ConfineIovaSpace

/-! ### The forwarding functions add nothing -/

theorem the_touches_interrupt_window_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    touches_interrupt_window a b = iova_space.touches_interrupt_window a b := rfl

theorem the_after_give_back_wrapper_is_its_method (a : Std.U64) (b : Std.U64) (c : Std.U64) :
    after_give_back a b c = iova_space.after_give_back a b c := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ConfineIovaSpace.the_touches_interrupt_window_wrapper_is_its_method
#print axioms NonosExtraction.ConfineIovaSpace.the_after_give_back_wrapper_is_its_method

/-! ### What the code decides -/

/-- **An overflowing range fails closed.** A range whose end does not fit in
    64 bits is reported as touching the interrupt window, so it is refused. -/
theorem overflow_touches (s l : Std.U64) (h : U64.checked_add s l = none) :
    touches_interrupt_window s l = ok true := by
  unfold touches_interrupt_window iova_space.touches_interrupt_window
  simp [lift, h]

#print axioms NonosExtraction.ConfineIovaSpace.overflow_touches

/-! ### Arithmetic -/

/-- Without overflow, `touches_interrupt_window` is the interval test
    `start < END ∧ start + length > START`. -/
theorem touches_spec (s l e : Std.U64) (h : U64.checked_add s l = some e) :
    touches_interrupt_window s l =
      ok (decide (s < iova_space.INTERRUPT_WINDOW_END) &&
          decide (e > iova_space.INTERRUPT_WINDOW_START)) := by
  unfold touches_interrupt_window iova_space.touches_interrupt_window
  simp only [lift, bind_tc_ok, h]
  by_cases hs : s < iova_space.INTERRUPT_WINDOW_END <;> simp [hs]

/-- A range that starts at or above the window's end does not touch it. -/
theorem above_window_clear (s l e : Std.U64) (h : U64.checked_add s l = some e)
    (hs : ¬ s < iova_space.INTERRUPT_WINDOW_END) : touches_interrupt_window s l = ok false := by
  rw [touches_spec s l e h]; simp [hs]

#print axioms NonosExtraction.ConfineIovaSpace.touches_spec
#print axioms NonosExtraction.ConfineIovaSpace.above_window_clear

end NonosExtraction.ConfineIovaSpace
