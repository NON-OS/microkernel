record, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MemoryMmioStatsRecord

open Aeneas Aeneas.Std Result
open nonos_x_memory_mmio_stats_record

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MemoryMmioStatsRecord

/-! ### The forwarding functions add nothing -/

theorem the_mmiostats_next_id_wrapper_is_its_method (a : memory.mmio.stats.types.MmioStats) :
    mmiostats_next_id a = memory.mmio.stats.record.MmioStats.next_id a := rfl

theorem the_mmiostats_record_mapping_wrapper_is_its_method (a : memory.mmio.stats.types.MmioStats) (b : Std.Usize) :
    mmiostats_record_mapping a b = memory.mmio.stats.record.MmioStats.record_mapping a b := rfl

theorem the_mmiostats_record_unmapping_wrapper_is_its_method (a : memory.mmio.stats.types.MmioStats) (b : Std.Usize) :
    mmiostats_record_unmapping a b = memory.mmio.stats.record.MmioStats.record_unmapping a b := rfl

theorem the_mmiostats_record_read_wrapper_is_its_method (a : memory.mmio.stats.types.MmioStats) :
    mmiostats_record_read a = memory.mmio.stats.record.MmioStats.record_read a := rfl

theorem the_mmiostats_record_write_wrapper_is_its_method (a : memory.mmio.stats.types.MmioStats) :
    mmiostats_record_write a = memory.mmio.stats.record.MmioStats.record_write a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MemoryMmioStatsRecord.the_mmiostats_next_id_wrapper_is_its_method
