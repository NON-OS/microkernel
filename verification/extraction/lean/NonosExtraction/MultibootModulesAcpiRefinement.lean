modules_acpi, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MultibootModulesAcpi

open Aeneas Aeneas.Std Result
open nonos_x_multiboot_modules_acpi

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MultibootModulesAcpi

/-! ### The forwarding functions add nothing -/

theorem the_acpirsdp_is_acpi2_wrapper_is_its_method (a : modules_acpi.AcpiRsdp) :
    acpirsdp_is_acpi2 a = modules_acpi.AcpiRsdp.is_acpi2 a := rfl

theorem the_acpirsdp_table_address_wrapper_is_its_method (a : modules_acpi.AcpiRsdp) :
    acpirsdp_table_address a = modules_acpi.AcpiRsdp.table_address a := rfl

theorem the_acpirsdp_verify_checksum_wrapper_is_its_method (a : modules_acpi.AcpiRsdp) :
    acpirsdp_verify_checksum a = modules_acpi.AcpiRsdp.verify_checksum a := rfl

theorem the_acpirsdp_verify_extended_checksum_wrapper_is_its_method (a : modules_acpi.AcpiRsdp) :
    acpirsdp_verify_extended_checksum a = modules_acpi.AcpiRsdp.verify_extended_checksum a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MultibootModulesAcpi.the_acpirsdp_is_acpi2_wrapper_is_its_method
#print axioms NonosExtraction.MultibootModulesAcpi.the_acpirsdp_table_address_wrapper_is_its_method
#print axioms NonosExtraction.MultibootModulesAcpi.the_acpirsdp_verify_checksum_wrapper_is_its_method
#print axioms NonosExtraction.MultibootModulesAcpi.the_acpirsdp_verify_extended_checksum_wrapper_is_its_method

end NonosExtraction.MultibootModulesAcpi
