pte, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.EncodePte
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_encode_pte

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.EncodePte

/-! ### The forwarding functions add nothing -/

theorem the_table_wrapper_is_its_method (a : Std.U64) :
    table a = pte.table a := rfl

theorem the_is_valid_wrapper_is_its_method (a : Std.U64) :
    is_valid a = pte.is_valid a := rfl

theorem the_address_wrapper_is_its_method (a : Std.U64) :
    address a = pte.address a := rfl

theorem the_level_index_wrapper_is_its_method (a : Std.U64) (b : Std.Usize) :
    level_index a b = pte.level_index a b := rfl

theorem the_in_range_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    in_range a b = pte.in_range a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.EncodePte.the_table_wrapper_is_its_method
#print axioms NonosExtraction.EncodePte.the_is_valid_wrapper_is_its_method
#print axioms NonosExtraction.EncodePte.the_address_wrapper_is_its_method
#print axioms NonosExtraction.EncodePte.the_level_index_wrapper_is_its_method
#print axioms NonosExtraction.EncodePte.the_in_range_wrapper_is_its_method

/-! ### What the code decides -/

private theorem and_within (x m : Std.U64) (i : Nat) (h : (x &&& m).val.testBit i = true) :
    m.val.testBit i = true := by
  rw [UScalar.val_and, Nat.testBit_and] at h
  cases hm : m.val.testBit i
  · rw [hm] at h; simp at h
  · rfl

/-- **An SMMU entry's output address never carries a flag bit.** -/
theorem address_within_mask (e r m : Std.U64) (h : address e = ok r) (hm : pte.OA_MASK = ok m)
    (i : Nat) (hi : r.val.testBit i = true) : m.val.testBit i = true := by
  unfold address pte.address at h
  simp only [hm, lift, bind_tc_ok, Result.ok.injEq] at h
  subst h
  exact and_within e m i hi

#print axioms NonosExtraction.EncodePte.address_within_mask

/-! ### Arithmetic -/

/-- **An accepted SMMU range ends inside the 39-bit input space.** When
    `in_range` accepts, `iova + size` neither overflows nor passes `2^39`. -/
theorem in_range_bound (i s : Std.U64) (h : in_range i s = ok true) :
    i.val + s.val ≤ 2 ^ 39 := by
  unfold in_range pte.in_range at h
  have spec := U64.checked_add_bv_spec i s
  cases hc : U64.checked_add i s with
  | none => simp [hc, lift] at h
  | some e =>
      rw [hc] at spec
      have hs : (1#u64 <<< 39#i32) = ok (549755813888#u64) := by rfl
      simp only [hc, lift, bind_tc_ok, hs, Result.ok.injEq, decide_eq_true_eq] at h
      have : e.val ≤ 549755813888 := h
      rw [← spec.2.1]
      simpa using this

#print axioms NonosExtraction.EncodePte.in_range_bound

end NonosExtraction.EncodePte
