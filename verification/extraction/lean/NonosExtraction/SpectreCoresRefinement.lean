cores, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.SpectreCores
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_spectre_cores

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.SpectreCores

/-! ### The forwarding functions add nothing -/

theorem the_is_arm_wrapper_is_its_method (a : Std.U8) :
    is_arm a = cores.is_arm a := rfl

theorem the_in_order_wrapper_is_its_method (a : Std.U8) (b : Std.U16) :
    in_order a b = cores.in_order a b := rfl

theorem the_meltdown_wrapper_is_its_method (a : Std.U8) (b : Std.U16) :
    meltdown a b = cores.meltdown a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.SpectreCores.the_is_arm_wrapper_is_its_method
#print axioms NonosExtraction.SpectreCores.the_in_order_wrapper_is_its_method
#print axioms NonosExtraction.SpectreCores.the_meltdown_wrapper_is_its_method

/-! ### What the code decides -/

/-- **Meltdown is reported only for an Arm core.** -/
theorem meltdown_only_arm (i : Std.U8) (p : Std.U16) (h : meltdown i p = ok true) :
    is_arm i = ok true := by
  unfold meltdown cores.meltdown at h
  unfold is_arm
  cases ha : cores.is_arm i with
  | ok b =>
      rw [ha] at h
      cases b
      · simp at h
      · rfl
  | fail e => rw [ha] at h; simp at h
  | div => rw [ha] at h; simp at h

#print axioms NonosExtraction.SpectreCores.meltdown_only_arm

end NonosExtraction.SpectreCores
