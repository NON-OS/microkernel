cpuid, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.SpectreMitigationsCpuid

open Aeneas Aeneas.Std Result
open nonos_x_spectre_mitigations_cpuid

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.SpectreMitigationsCpuid

/-! ### The forwarding functions add nothing -/

theorem the_has_ibrs_ibpb_wrapper_is_its_method :
    has_ibrs_ibpb = cpuid.has_ibrs_ibpb := rfl

theorem the_has_stibp_wrapper_is_its_method :
    has_stibp = cpuid.has_stibp := rfl

theorem the_has_ssbd_wrapper_is_its_method :
    has_ssbd = cpuid.has_ssbd := rfl

theorem the_has_l1d_flush_wrapper_is_its_method :
    has_l1d_flush = cpuid.has_l1d_flush := rfl

theorem the_has_md_clear_wrapper_is_its_method :
    has_md_clear = cpuid.has_md_clear := rfl

theorem the_has_arch_capabilities_wrapper_is_its_method :
    has_arch_capabilities = cpuid.has_arch_capabilities := rfl

theorem the_is_amd_wrapper_is_its_method :
    is_amd = cpuid.is_amd := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.SpectreMitigationsCpuid.the_has_ibrs_ibpb_wrapper_is_its_method
#print axioms NonosExtraction.SpectreMitigationsCpuid.the_has_stibp_wrapper_is_its_method
#print axioms NonosExtraction.SpectreMitigationsCpuid.the_has_ssbd_wrapper_is_its_method
#print axioms NonosExtraction.SpectreMitigationsCpuid.the_has_l1d_flush_wrapper_is_its_method
#print axioms NonosExtraction.SpectreMitigationsCpuid.the_has_md_clear_wrapper_is_its_method
#print axioms NonosExtraction.SpectreMitigationsCpuid.the_has_arch_capabilities_wrapper_is_its_method
#print axioms NonosExtraction.SpectreMitigationsCpuid.the_is_amd_wrapper_is_its_method

end NonosExtraction.SpectreMitigationsCpuid
