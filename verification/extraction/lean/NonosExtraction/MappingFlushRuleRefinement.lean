flush_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MappingFlushRule

open Aeneas Aeneas.Std Result
open nonos_x_mapping_flush_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MappingFlushRule

/-! ### The forwarding functions add nothing -/

theorem the_invalidates_wrapper_is_its_method (a : Bool) (b : Bool) :
    invalidates a b = flush_rule.invalidates a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MappingFlushRule.the_invalidates_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `invalidates` is `!mapped || caching_mode`. -/
theorem invalidates_spec (m c : Bool) : invalidates m c = ok (!m || c) := by
  cases m <;> cases c <;> rfl

/-- An unmap is always invalidated, whatever the unit's caching mode, so no
    unit keeps a translation the kernel removed. -/
theorem unmap_always_invalidated (c : Bool) : invalidates false c = ok true := by
  cases c <;> rfl

/-- Under caching mode a map is invalidated too. -/
theorem caching_mode_always_invalidated (m : Bool) : invalidates m true = ok true := by
  cases m <;> rfl

#print axioms NonosExtraction.MappingFlushRule.invalidates_spec
#print axioms NonosExtraction.MappingFlushRule.unmap_always_invalidated

end NonosExtraction.MappingFlushRule
