import NonosExtraction.CapabilityGrantRule
import NonosExtraction.Bits
import Nonos.GrantEnvelope
import Nonos.RevokeBound

open Aeneas Aeneas.Std Result
open nonos_x_capability_grant_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.CapabilityGrantRule

/-! ### The forwarding functions add nothing -/

theorem the_may_grant_wrapper_is_its_method (a : Std.U64) (b : Std.U64) (c : Std.U64) :
    may_grant a b c = grant_rule.may_grant a b c := rfl

theorem the_within_envelope_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    within_envelope a b = grant_rule.within_envelope a b := rfl

theorem the_may_revoke_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    may_revoke a b = grant_rule.may_revoke a b := rfl

theorem the_revoke_decision_wrapper_is_its_method (a b c d e : Bool) :
    revoke_decision a b c d e = grant_rule.revoke_decision a b c d e := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.CapabilityGrantRule.the_may_grant_wrapper_is_its_method
#print axioms NonosExtraction.CapabilityGrantRule.the_within_envelope_wrapper_is_its_method
#print axioms NonosExtraction.CapabilityGrantRule.the_may_revoke_wrapper_is_its_method

/-! ### The extracted rule is the Lean model

    `Nonos.GrantEnvelope` states the grant decision on words and proves that
    no sequence of grants takes a process past its envelope. The theorems
    below show the extracted `may_grant`, `within_envelope` and `may_revoke`
    compute exactly the model's tests for every 64-bit input, so those
    theorems hold of the code that runs.
-/

private theorem high_clear (x : Std.U64) (i : Nat) (hi : ¬ i < 64) : x.val.testBit i = false :=
  Bits.testBit_val_high x i (by simp only [UScalarTy.numBits]; omega)

private theorem word_eq_zero_iff (x : Std.U64) : x = 0#u64 ↔ ∀ i, x.val.testBit i = false := by
  rw [← Bits.val_eq_zero_iff]
  exact ⟨fun h => by rw [h]; rfl, fun h => UScalar.eq_of_val_eq (by rw [h]; rfl)⟩

/-- `mask & !envelope == 0` is the model's `Within`. -/
theorem within_envelope_is_the_model (m e : Std.U64) :
    ∃ b, within_envelope m e = ok b ∧ (b = true ↔ Nonos.WordSet.Within m.val e.val) := by
  unfold within_envelope grant_rule.within_envelope
  simp only [lift, bind_tc_ok]
  refine ⟨_, rfl, ?_⟩
  rw [decide_eq_true_iff, word_eq_zero_iff, Nonos.WordSet.within_iff]
  simp only [UScalar.val_and, Nat.testBit_and, Bits.testBit_val_not, Nonos.WordSet.bit]
  constructor
  · intro h i hi
    have hi' := h i
    by_cases hlt : i < 64
    · cases he : e.val.testBit i
      · simp only [he, hi, hlt, UScalarTy.numBits] at hi'
        simp at hi'
      · rfl
    · rw [high_clear m i hlt] at hi
      cases hi
  · intro h i
    cases hm : m.val.testBit i
    · simp
    · rw [h i hm]
      simp

/-- `held & mask == mask` is the model's `Within mask held`. -/
private theorem and_eq_iff (h m : Std.U64) : (h &&& m) = m ↔ Nonos.WordSet.Within m.val h.val := by
  rw [Nonos.WordSet.within_iff]
  constructor
  · intro he i hi
    have := congrArg (fun x : Std.U64 => x.val.testBit i) he
    simp only [UScalar.val_and, Nat.testBit_and] at this
    simp only [Nonos.WordSet.bit] at hi ⊢
    rw [hi] at this
    simpa using this
  · intro hw
    apply UScalar.eq_of_val_eq
    apply Nat.eq_of_testBit_eq
    intro i
    simp only [UScalar.val_and, Nat.testBit_and]
    cases hm : m.val.testBit i
    · simp
    · have := hw i (by simpa [Nonos.WordSet.bit] using hm)
      simp only [Nonos.WordSet.bit] at this
      simp [this]

/-- `may_grant` is the model's `mayGrant`. -/
theorem may_grant_is_the_model (h a m : Std.U64) :
    ∃ b, may_grant h a m = ok b ∧
      (b = true ↔ (h.val &&& a.val) ≠ 0 ∧ Nonos.WordSet.Within m.val h.val) := by
  unfold may_grant grant_rule.may_grant
  simp only [lift, bind_tc_ok]
  by_cases hz : (h &&& a) != 0#u64
  · rw [if_pos hz]
    refine ⟨_, rfl, ?_⟩
    rw [decide_eq_true_iff, and_eq_iff]
    have : (h.val &&& a.val) ≠ 0 := by
      intro h0
      apply (bne_iff_ne.1 hz)
      apply UScalar.eq_of_val_eq
      rw [UScalar.val_and, h0]; rfl
    exact ⟨fun hw => ⟨this, hw⟩, fun hp => hp.2⟩
  · rw [if_neg hz]
    refine ⟨_, rfl, ?_⟩
    simp only [Bool.false_eq_true, false_iff, not_and]
    intro hne
    exfalso
    apply hz
    apply bne_iff_ne.2
    intro he
    apply hne
    have := congrArg (fun x : Std.U64 => x.val) he
    simpa [UScalar.val_and] using this

/-- **The grant envelope holds on the code.** When the extracted rules pass,
    the target's word plus the mask stays inside the envelope; a sequence of
    such grants never leaves it (`Nonos.GrantEnvelope.grants_stay_in_envelope`). -/
theorem envelope_holds_on_the_code (m e t : Std.U64) (b : Bool)
    (hw : within_envelope m e = ok b) (hb : b = true)
    (ht : Nonos.WordSet.Within t.val e.val) :
    Nonos.WordSet.Within (t.val ||| m.val) e.val := by
  obtain ⟨b', hb', hiff⟩ := within_envelope_is_the_model m e
  rw [hw] at hb'
  cases hb'
  exact Nonos.WordSet.within_or ht (hiff.1 hb)

#print axioms NonosExtraction.CapabilityGrantRule.within_envelope_is_the_model
#print axioms NonosExtraction.CapabilityGrantRule.may_grant_is_the_model
#print axioms NonosExtraction.CapabilityGrantRule.envelope_holds_on_the_code

/-- **The revoke bound, on the code.** The extracted `revoke_decision` is the
    model's `Nonos.RevokeBound.decision` on all 32 inputs, so the model's
    theorems (only init reaches a protected service; a stranger with Admin is
    refused; the bound only narrows the old rule) hold of the compiled Rust. -/
theorem revoke_decision_is_the_model (a b c d e : Bool) :
    revoke_decision a b c d e = ok (Nonos.RevokeBound.decision a b c d e) := by
  cases a <;> cases b <;> cases c <;> cases d <;> cases e <;> rfl

#print axioms NonosExtraction.CapabilityGrantRule.revoke_decision_is_the_model

end NonosExtraction.CapabilityGrantRule
