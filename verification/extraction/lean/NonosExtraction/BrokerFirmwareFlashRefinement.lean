firmware_flash, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.BrokerFirmwareFlash

open Aeneas Aeneas.Std Result
open nonos_x_broker_firmware_flash

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.BrokerFirmwareFlash

/-! ### The forwarding functions add nothing -/

theorem the_is_flash_function_wrapper_is_its_method (a : Std.U16) (b : Std.U8) (c : Std.U8) (d : Std.U8) :
    is_flash_function a b c d = firmware_flash.is_flash_function a b c d := rfl

theorem the_overlaps_flash_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    overlaps_flash a b = firmware_flash.overlaps_flash a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.BrokerFirmwareFlash.the_is_flash_function_wrapper_is_its_method
#print axioms NonosExtraction.BrokerFirmwareFlash.the_overlaps_flash_wrapper_is_its_method

/-! ### Arithmetic -/

/-- An empty range never overlaps the flash window. -/
theorem empty_never_overlaps (b : Std.U64) : overlaps_flash b 0#u64 = ok false := by
  unfold overlaps_flash firmware_flash.overlaps_flash
  simp [lift]

#print axioms NonosExtraction.BrokerFirmwareFlash.empty_never_overlaps

end NonosExtraction.BrokerFirmwareFlash
