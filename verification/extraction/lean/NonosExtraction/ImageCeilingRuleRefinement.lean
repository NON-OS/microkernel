rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ImageCeilingRule
import NonosExtraction.Bits
import Nonos.ImageCeilingGate

open Aeneas Aeneas.Std Result
open nonos_x_image_ceiling_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ImageCeilingRule

/-! ### The forwarding functions add nothing -/

theorem the_over_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    over a b = rule.over a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ImageCeilingRule.the_over_wrapper_is_its_method

/-! ### The extracted rule is the Lean model

    `Nonos.ImageCeilingGate` proves the gate admits a request exactly when
    nothing is over the ceiling, names only forbidden bits, and is monotone in
    both arguments. The theorem below shows the extracted `over` computes the
    model's `over` for every pair of 64-bit words, so those theorems hold of
    the code the spawn path runs.
-/

/-- `requested & !ceiling` is the model's `over`, bit for bit. -/
theorem over_is_the_model (r c : Std.U64) :
    ∃ w, over r c = ok w ∧ w.val = Nonos.ImageCeilingGate.over r.val c.val := by
  unfold over rule.over
  simp only [lift, bind_tc_ok]
  refine ⟨_, rfl, ?_⟩
  apply Nat.eq_of_testBit_eq
  intro i
  have hx := Nonos.WordSet.bit_excess r.val c.val i
  unfold Nonos.ImageCeilingGate.over
  simp only [Nonos.WordSet.bit] at hx
  rw [hx, UScalar.val_and, Nat.testBit_and, Bits.testBit_val_not]
  by_cases hlt : i < 64
  · simp [hlt, UScalarTy.numBits]
  · rw [Bits.testBit_val_high r i (by simp only [UScalarTy.numBits]; omega)]
    simp

/-- **The ceiling gate, on the code.** The extracted `over` is zero exactly
    when the request lies within the ceiling. -/
theorem over_zero_iff_within (r c : Std.U64) :
    ∃ w, over r c = ok w ∧ (w.val = 0 ↔ Nonos.WordSet.Within r.val c.val) := by
  obtain ⟨w, hw, he⟩ := over_is_the_model r c
  exact ⟨w, hw, by rw [he]; rfl⟩

#print axioms NonosExtraction.ImageCeilingRule.over_is_the_model
#print axioms NonosExtraction.ImageCeilingRule.over_zero_iff_within

end NonosExtraction.ImageCeilingRule
