theorem the_record_error_event_wrapper_is_its_method :
    record_error_event = drivers.pci.stats.record.record_error_event := rfl

theorem the_reset_stats_wrapper_is_its_method :
    reset_stats = drivers.pci.stats.record.reset_stats := rfl

