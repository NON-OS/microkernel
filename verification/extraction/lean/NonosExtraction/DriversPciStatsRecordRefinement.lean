theorem the_record_interrupt_wrapper_is_its_method (a : Bool) :
    record_interrupt a = drivers.pci.stats.record.record_interrupt a := rfl

theorem the_record_hotplug_event_wrapper_is_its_method :
    record_hotplug_event = drivers.pci.stats.record.record_hotplug_event := rfl

theorem the_record_power_state_change_wrapper_is_its_method :
    record_power_state_change = drivers.pci.stats.record.record_power_state_change := rfl

theorem the_record_link_state_change_wrapper_is_its_method :
