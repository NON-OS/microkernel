volume_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.BlockDeviceVolumeRule

open Aeneas Aeneas.Std Result
open nonos_x_block_device_volume_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.BlockDeviceVolumeRule

/-! ### The forwarding functions add nothing -/

theorem the_admits_wrapper_is_its_method (a : Bool) (b : Bool) (c : Bool) :
    admits a b c = volume_rule.admits a b c := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.BlockDeviceVolumeRule.the_admits_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `admits` is `driver || storage || volume_io`. -/
theorem admits_spec (v d s : Bool) : admits v d s = ok (d || s || v) := by
  cases v <;> cases d <;> cases s <;> rfl

/-- A caller that is not a driver, not the store holder and not the volume's
    own I/O is refused the block clients. -/
theorem stranger_refused : admits false false false = ok false := rfl

#print axioms NonosExtraction.BlockDeviceVolumeRule.admits_spec
#print axioms NonosExtraction.BlockDeviceVolumeRule.stranger_refused

end NonosExtraction.BlockDeviceVolumeRule
