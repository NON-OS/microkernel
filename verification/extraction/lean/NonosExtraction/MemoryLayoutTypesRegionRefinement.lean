region, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MemoryLayoutTypesRegion

open Aeneas Aeneas.Std Result
open nonos_x_memory_layout_types_region

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MemoryLayoutTypesRegion

/-! ### The forwarding functions add nothing -/

theorem the_region_len_wrapper_is_its_method (a : memory.layout.types.region.Region) :
    region_len a = memory.layout.types.region.Region.len a := rfl

theorem the_region_is_empty_wrapper_is_its_method (a : memory.layout.types.region.Region) :
    region_is_empty a = memory.layout.types.region.Region.is_empty a := rfl

theorem the_region_is_usable_wrapper_is_its_method (a : memory.layout.types.region.Region) :
    region_is_usable a = memory.layout.types.region.Region.is_usable a := rfl

theorem the_region_start_addr_wrapper_is_its_method (a : memory.layout.types.region.Region) :
    region_start_addr a = memory.layout.types.region.Region.start_addr a := rfl

theorem the_region_end_addr_wrapper_is_its_method (a : memory.layout.types.region.Region) :
    region_end_addr a = memory.layout.types.region.Region.end_addr a := rfl

theorem the_region_page_count_wrapper_is_its_method (a : memory.layout.types.region.Region) :
    region_page_count a = memory.layout.types.region.Region.page_count a := rfl

theorem the_region_contains_wrapper_is_its_method (a : memory.layout.types.region.Region) (b : Std.U64) :
    region_contains a b = memory.layout.types.region.Region.contains a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_len_wrapper_is_its_method
#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_is_empty_wrapper_is_its_method
#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_is_usable_wrapper_is_its_method
#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_start_addr_wrapper_is_its_method
#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_end_addr_wrapper_is_its_method
#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_page_count_wrapper_is_its_method
#print axioms NonosExtraction.MemoryLayoutTypesRegion.the_region_contains_wrapper_is_its_method

end NonosExtraction.MemoryLayoutTypesRegion
