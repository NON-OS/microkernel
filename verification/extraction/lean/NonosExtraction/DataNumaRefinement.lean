numa, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.DataNuma

open Aeneas Aeneas.Std Result
open nonos_x_data_numa

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.DataNuma

/-! ### The forwarding functions add nothing -/

theorem the_numamemoryregion_end_wrapper_is_its_method (a : numa.NumaMemoryRegion) :
    numamemoryregion_end a = numa.NumaMemoryRegion.end a := rfl

theorem the_numamemoryregion_contains_wrapper_is_its_method (a : numa.NumaMemoryRegion) (b : Std.U64) :
    numamemoryregion_contains a b = numa.NumaMemoryRegion.contains a b := rfl

/-! ### Where a NUMA region stops

    `end` is the base plus the length, clamped at the largest address.
    `contains` measures the address from the base and compares that offset with
    the length, so it is the half open range `[base, base + length)` on the true
    sum. `AcpiData::find_numa_node` reports the proximity domain of the first
    region that contains an address, so the theorems below fix the end exactly,
    show that `contains` is the true range and that an empty region claims no
    address. `contains` used to compare with the clamped end, which left the last
    byte of a region reaching `2 ^ 64` in no domain; the last theorem is that
    edge now.

    They speak about one region at a time. The search over the region list in
    `find_numa_node`, and the SRAT parser that fills that list, are not in the
    extracted crate, so nothing here says the list is ordered, disjoint or
    complete.
-/

private theorem u64_saturating_add_val (a b : Std.U64) :
    (core.num.U64.saturating_add a b).val = min (2 ^ 64 - 1) (a.val + b.val) := by
  simp only [core.num.U64.saturating_add, UScalar.saturating_add, UScalar.val, UScalar.max]
  rw [BitVec.toNat_ofNat]
  show min (2 ^ 64 - 1) _ % 2 ^ 64 = _
  exact Nat.mod_eq_of_lt (by omega)

private theorem sub_ok (x y : Std.U64) (h : y.val ≤ x.val) :
    ∃ z : Std.U64, x - y = ok z ∧ z.val = x.val - y.val := by
  have e := UScalar.sub_equiv x y
  cases hr : (x - y : Result Std.U64) with
  | ok z => rw [hr] at e; exact ⟨z, rfl, by omega⟩
  | fail _ => rw [hr] at e; simp at e; omega
  | div => rw [hr] at e; exact e.elim

/-- The end of a region is its base plus its length, pinned at the largest
    address when the sum would not fit. A wrapping sum would put the end of a
    region near the top below its own base. -/
theorem numamemoryregion_end_is_the_saturated_sum (r : numa.NumaMemoryRegion) :
    ∃ e, numamemoryregion_end r = ok e ∧
      e.val = min (2 ^ 64 - 1) (r.base.val + r.length.val) :=
  ⟨_, rfl, u64_saturating_add_val _ _⟩

/-- An address is in a region exactly when it is at or above the base and below
    the base plus the length, computed without a clamp, for every region. -/
theorem numamemoryregion_contains_is_the_half_open_range
    (r : numa.NumaMemoryRegion) (addr : Std.U64) :
    numamemoryregion_contains r addr =
      ok (decide (r.base.val ≤ addr.val ∧ addr.val < r.base.val + r.length.val)) := by
  unfold numamemoryregion_contains numa.NumaMemoryRegion.contains
  by_cases hb : r.base.val ≤ addr.val
  · have h : addr >= r.base := hb
    obtain ⟨z, hz, hv⟩ := sub_ok addr r.base hb
    simp only [h, ite_true, hz, bind_tc_ok, hb, true_and]
    congr 1
    simp only [decide_eq_decide]
    show z.val < r.length.val ↔ _
    omega
  · have h : ¬ (addr >= r.base) := hb
    simp only [h, ite_false, hb, false_and, decide_false]

/-- A region of length zero claims no address, not even its own base, so a
    zero length SRAT entry cannot capture lookups for the address it names. -/
theorem numamemoryregion_contains_nothing_when_the_length_is_zero
    (r : numa.NumaMemoryRegion) (addr : Std.U64) (h : r.length.val = 0) :
    numamemoryregion_contains r addr = ok false := by
  rw [numamemoryregion_contains_is_the_half_open_range]
  congr 1
  simp only [decide_eq_false_iff_not, not_and, not_lt]
  omega

/-- A region whose true end is exactly `2 ^ 64` holds the address `2 ^ 64 - 1`,
    although `end` clamps to that same address. With the clamped comparison the
    last byte belonged to no domain. -/
theorem numamemoryregion_contains_the_last_address_of_a_region_reaching_the_top :
    numamemoryregion_contains
        ⟨0xFFFFFFFFFFFFF000#u64, 0x1000#u64, 0#u32, false, false⟩
        0xFFFFFFFFFFFFFFFF#u64 = ok true ∧
      numamemoryregion_end ⟨0xFFFFFFFFFFFFF000#u64, 0x1000#u64, 0#u32, false, false⟩ =
        ok 0xFFFFFFFFFFFFFFFF#u64 := by
  refine ⟨?_, ?_⟩
  · rw [numamemoryregion_contains_is_the_half_open_range]
    rfl
  · obtain ⟨e, he, hv⟩ := numamemoryregion_end_is_the_saturated_sum
      ⟨0xFFFFFFFFFFFFF000#u64, 0x1000#u64, 0#u32, false, false⟩
    rw [he]
    congr 1
    apply UScalar.eq_of_val_eq
    rw [hv]
    simp

/-! ### Axiom profile -/

#print axioms NonosExtraction.DataNuma.the_numamemoryregion_end_wrapper_is_its_method
#print axioms NonosExtraction.DataNuma.the_numamemoryregion_contains_wrapper_is_its_method
#print axioms NonosExtraction.DataNuma.numamemoryregion_end_is_the_saturated_sum
#print axioms NonosExtraction.DataNuma.numamemoryregion_contains_is_the_half_open_range
#print axioms NonosExtraction.DataNuma.numamemoryregion_contains_nothing_when_the_length_is_zero
#print axioms NonosExtraction.DataNuma.numamemoryregion_contains_the_last_address_of_a_region_reaching_the_top

end NonosExtraction.DataNuma
