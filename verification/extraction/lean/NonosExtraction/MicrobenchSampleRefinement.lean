sample, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MicrobenchSample

open Aeneas Aeneas.Std Result
open nonos_x_microbench_sample

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MicrobenchSample

/-! ### The forwarding functions add nothing -/

theorem the_sample_new_wrapper_is_its_method :
    sample_new = sample.Sample.new := rfl

theorem the_sample_len_wrapper_is_its_method (a : sample.Sample) :
    sample_len a = sample.Sample.len a := rfl

theorem the_sample_quantile_wrapper_is_its_method (a : sample.Sample) (b : Std.Usize) (c : Std.Usize) :
    sample_quantile a b c = sample.Sample.quantile a b c := rfl

theorem the_sample_min_wrapper_is_its_method (a : sample.Sample) :
    sample_min a = sample.Sample.min a := rfl

theorem the_sample_max_wrapper_is_its_method (a : sample.Sample) :
    sample_max a = sample.Sample.max a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MicrobenchSample.the_sample_new_wrapper_is_its_method
#print axioms NonosExtraction.MicrobenchSample.the_sample_len_wrapper_is_its_method
#print axioms NonosExtraction.MicrobenchSample.the_sample_quantile_wrapper_is_its_method
#print axioms NonosExtraction.MicrobenchSample.the_sample_min_wrapper_is_its_method
#print axioms NonosExtraction.MicrobenchSample.the_sample_max_wrapper_is_its_method

end NonosExtraction.MicrobenchSample
