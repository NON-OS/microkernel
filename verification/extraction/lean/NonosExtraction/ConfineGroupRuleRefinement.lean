group_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ConfineGroupRule

open Aeneas Aeneas.Std Result
open nonos_x_confine_group_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ConfineGroupRule

/-! ### The forwarding functions add nothing -/

theorem the_may_share_wrapper_is_its_method (a : Bool) (b : Bool) (c : Bool) (d : Bool) :
    may_share a b c d = group_rule.may_share a b c d := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ConfineGroupRule.the_may_share_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `may_share` is `built && !hardened && vendor && reaches`. -/
theorem may_share_spec (b h v r : Bool) : may_share b h v r = ok (b && !h && v && r) := by
  cases b <;> cases h <;> cases v <;> cases r <;> rfl

/-- **A hardened or air-gapped boot never shares an isolation group.** -/
theorem hardened_never_shares (b v r : Bool) : may_share b true v r = ok false := by
  cases b <;> cases v <;> cases r <;> rfl

/-- Only the vendor's capsules ever share a group. -/
theorem non_vendor_never_shares (b h r : Bool) : may_share b h false r = ok false := by
  cases b <;> cases h <;> cases r <;> rfl

#print axioms NonosExtraction.ConfineGroupRule.may_share_spec
#print axioms NonosExtraction.ConfineGroupRule.hardened_never_shares
#print axioms NonosExtraction.ConfineGroupRule.non_vendor_never_shares

end NonosExtraction.ConfineGroupRule
