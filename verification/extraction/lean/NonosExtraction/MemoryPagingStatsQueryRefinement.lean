query, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MemoryPagingStatsQuery

open Aeneas Aeneas.Std Result
open nonos_x_memory_paging_stats_query

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MemoryPagingStatsQuery

/-! ### The forwarding functions add nothing -/

theorem the_pagingstatistics_total_mappings_wrapper_is_its_method (a : memory.paging.stats.state.PagingStatistics) :
    pagingstatistics_total_mappings a = memory.paging.stats.query.PagingStatistics.total_mappings a := rfl

theorem the_pagingstatistics_page_faults_wrapper_is_its_method (a : memory.paging.stats.state.PagingStatistics) :
    pagingstatistics_page_faults a = memory.paging.stats.query.PagingStatistics.page_faults a := rfl

theorem the_pagingstatistics_tlb_flushes_wrapper_is_its_method (a : memory.paging.stats.state.PagingStatistics) :
    pagingstatistics_tlb_flushes a = memory.paging.stats.query.PagingStatistics.tlb_flushes a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MemoryPagingStatsQuery.the_pagingstatistics_total_mappings_wrapper_is_its_method
#print axioms NonosExtraction.MemoryPagingStatsQuery.the_pagingstatistics_page_faults_wrapper_is_its_method
#print axioms NonosExtraction.MemoryPagingStatsQuery.the_pagingstatistics_tlb_flushes_wrapper_is_its_method

end NonosExtraction.MemoryPagingStatsQuery
