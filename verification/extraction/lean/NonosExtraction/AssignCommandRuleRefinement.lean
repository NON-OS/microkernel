command_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.AssignCommandRule
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_assign_command_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.AssignCommandRule

/-! ### The forwarding functions add nothing -/

theorem the_while_sizing_wrapper_is_its_method (a : Std.U16) :
    while_sizing a = command_rule.while_sizing a := rfl

theorem the_after_assign_wrapper_is_its_method (a : Std.U16) :
    after_assign a = command_rule.after_assign a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.AssignCommandRule.the_while_sizing_wrapper_is_its_method
#print axioms NonosExtraction.AssignCommandRule.the_after_assign_wrapper_is_its_method

/-! ### What the code decides -/

private theorem clear_bits (c off b : Std.U16)
    (hb : ∀ i, b.val.testBit i = true → off.val.testBit i = true) :
    ((c &&& ~~~off) &&& b) = 0#u16 := by
  apply UScalar.eq_of_val_eq
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [UScalar.val_and, Nat.testBit_and, Bits.testBit_val_not]
  cases hbi : b.val.testBit i
  · simp
  · rw [hb i hbi]; simp

private theorem or_covers_left (a b : Std.U16) (i : Nat) (h : a.val.testBit i = true) :
    (a ||| b).val.testBit i = true := by
  rw [UScalar.val_or, Nat.testBit_or, h]; rfl

private theorem or_covers_right (a b : Std.U16) (i : Nat) (h : b.val.testBit i = true) :
    (a ||| b).val.testBit i = true := by
  rw [UScalar.val_or, Nat.testBit_or, h]; cases a.val.testBit i <;> rfl

/-- **No decoding while a BAR is sized.** The command word written while
    sizing has I/O and memory decoding off, so the all-ones probe never
    decodes onto the bus. -/
theorem sizing_decodes_nothing (f r io mem : Std.U16) (h : while_sizing f = ok r)
    (hio : command_rule.IO_SPACE = ok io) (hmem : command_rule.MEMORY_SPACE = ok mem) :
    (r &&& io) = 0#u16 ∧ (r &&& mem) = 0#u16 := by
  unfold while_sizing command_rule.while_sizing at h
  simp only [hio, hmem, lift, bind_tc_ok, Result.ok.injEq] at h
  subst h
  exact ⟨clear_bits f (io ||| mem) io (fun i hi => or_covers_left io mem i hi),
    clear_bits f (io ||| mem) mem (fun i hi => or_covers_right io mem i hi)⟩

#print axioms NonosExtraction.AssignCommandRule.sizing_decodes_nothing

end NonosExtraction.AssignCommandRule
