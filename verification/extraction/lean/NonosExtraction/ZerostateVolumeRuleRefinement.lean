volume_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ZerostateVolumeRule

open Aeneas Aeneas.Std Result
open nonos_x_zerostate_volume_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ZerostateVolumeRule

/-! ### The forwarding functions add nothing -/

theorem the_drop_at_arm_wrapper_is_its_method (a : Bool) :
    drop_at_arm a = volume_rule.drop_at_arm a := rfl

theorem the_may_write_wrapper_is_its_method (a : Bool) (b : Bool) :
    may_write a b = volume_rule.may_write a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ZerostateVolumeRule.the_drop_at_arm_wrapper_is_its_method
#print axioms NonosExtraction.ZerostateVolumeRule.the_may_write_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `may_write` is `ram || keeping`. -/
theorem may_write_spec (r k : Bool) : may_write r k = ok (r || k) := by
  cases r <;> cases k <;> rfl

/-- **Nothing reaches the disk on a boot that does not keep.** A volume not in
    RAM is written only when the person chose to keep. -/
theorem disk_needs_keeping : may_write false false = ok false := rfl

/-- The RAM volume is dropped at arm exactly when it was held for the disk. -/
theorem drop_at_arm_spec (h : Bool) : drop_at_arm h = ok h := rfl

#print axioms NonosExtraction.ZerostateVolumeRule.may_write_spec
#print axioms NonosExtraction.ZerostateVolumeRule.disk_needs_keeping

end NonosExtraction.ZerostateVolumeRule
