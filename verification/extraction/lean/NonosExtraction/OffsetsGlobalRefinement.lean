global, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.OffsetsGlobal
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_offsets_global

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.OffsetsGlobal

/-! ### The forwarding functions add nothing -/

theorem the_gcmd_with_wrapper_is_its_method (a : Std.U32) (b : Std.U32) :
    gcmd_with a b = global.gcmd_with a b := rfl

theorem the_gcmd_without_te_wrapper_is_its_method (a : Std.U32) :
    gcmd_without_te a = global.gcmd_without_te a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.OffsetsGlobal.the_gcmd_with_wrapper_is_its_method
#print axioms NonosExtraction.OffsetsGlobal.the_gcmd_without_te_wrapper_is_its_method

/-! ### What the code decides -/

/-- **Translation-enable is never set by `gcmd_without_te`.** Whatever the
    status register reads, the command word it writes has the TE bit clear. -/
theorem without_te_clears_te (s : Std.U32) (r t : Std.U32)
    (hr : gcmd_without_te s = ok r) (ht : global.GCMD_TE = ok t) : (r &&& t) = 0#u32 := by
  unfold gcmd_without_te global.gcmd_without_te at hr
  cases ho : global.GCMD_ONE_SHOT <;> simp only [ho, ht, lift, bind_tc_ok, bind_tc_fail, bind_tc_div] at hr <;> try cases hr
  apply UScalar.eq_of_val_eq
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [UScalar.val_and, Nat.testBit_and, Bits.testBit_val_not]
  cases t.val.testBit i <;> simp

#print axioms NonosExtraction.OffsetsGlobal.without_te_clears_te

end NonosExtraction.OffsetsGlobal
