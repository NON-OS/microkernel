rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.AcsRule
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_acs_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.AcsRule

/-! ### The forwarding functions add nothing -/

theorem the_closed_wrapper_is_its_method (a : Std.U16) :
    closed a = rule.closed a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.AcsRule.the_closed_wrapper_is_its_method

/-! ### What the code decides -/

/-- **ACS is reported closed only when every needed control is on and
    direct translated P2P is off.** -/
theorem closed_spec (ctl : Std.U16) (h : closed ctl = ok true) :
    (∃ n, rule.NEEDED = ok n ∧ (ctl &&& n) = n) ∧ (∃ d, rule.DIRECT = ok d ∧ (ctl &&& d) = 0#u16) := by
  unfold closed rule.closed at h
  cases hn : rule.NEEDED with
  | ok n =>
      simp only [hn, lift, bind_tc_ok] at h
      by_cases he : (ctl &&& n) = n
      · simp only [he, if_true] at h
        cases hd : rule.DIRECT with
        | ok d =>
            simp only [hd, bind_tc_ok, Result.ok.injEq, decide_eq_true_eq] at h
            exact ⟨⟨n, rfl, he⟩, ⟨d, rfl, h⟩⟩
        | fail e => simp [hd] at h
        | div => simp [hd] at h
      · simp [he] at h
  | fail e => simp [hn] at h
  | div => simp [hn] at h

#print axioms NonosExtraction.AcsRule.closed_spec

end NonosExtraction.AcsRule
