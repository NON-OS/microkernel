queue, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.EncodeQueue
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_encode_queue

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.EncodeQueue

/-! ### The forwarding functions add nothing -/

theorem the_index_wrapper_is_its_method (a : Std.U32) (b : Std.U8) :
    index a b = queue.index a b := rfl

theorem the_is_empty_wrapper_is_its_method (a : Std.U32) (b : Std.U32) (c : Std.U8) :
    is_empty a b c = queue.is_empty a b c := rfl

theorem the_is_full_wrapper_is_its_method (a : Std.U32) (b : Std.U32) (c : Std.U8) :
    is_full a b c = queue.is_full a b c := rfl

theorem the_advance_wrapper_is_its_method (a : Std.U32) (b : Std.U8) :
    advance a b = queue.advance a b := rfl

theorem the_consumed_wrapper_is_its_method (a : Std.U32) (b : Std.U32) (c : Std.U8) :
    consumed a b c = queue.consumed a b c := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.EncodeQueue.the_index_wrapper_is_its_method
#print axioms NonosExtraction.EncodeQueue.the_is_empty_wrapper_is_its_method
#print axioms NonosExtraction.EncodeQueue.the_is_full_wrapper_is_its_method
#print axioms NonosExtraction.EncodeQueue.the_advance_wrapper_is_its_method
#print axioms NonosExtraction.EncodeQueue.the_consumed_wrapper_is_its_method

/-! ### What the code decides -/

/-- **A ring is never both empty and full.** For any producer and consumer
    index and any queue size, `is_empty` and `is_full` never both answer true:
    both compare the same slot and the same wrap bit, one asking equal and the
    other different. -/
theorem never_empty_and_full (p c : Std.U32) (l : Std.U8) (a b : Bool)
    (ha : is_empty p c l = ok a) (hb : is_full p c l = ok b) : ¬ (a = true ∧ b = true) := by
  unfold is_empty is_full queue.is_empty queue.is_full at *
  cases hi : queue.index p l <;> cases hj : queue.index c l <;> simp only [hi, hj, bind_tc_ok, bind_tc_fail, bind_tc_div] at ha hb <;> try cases ha
  rename_i i j
  by_cases he : i = j
  · simp only [he, if_true] at ha hb
    cases hw : queue.wrap p l <;> cases hv : queue.wrap c l <;> simp only [hw, hv, bind_tc_ok, bind_tc_fail, bind_tc_div] at ha hb <;> try cases ha
    try cases hb
    intro ⟨h1, h2⟩
    simp only [decide_eq_true_eq] at h1
    simp only [bne_iff_ne, ne_eq] at h2
    exact h2 h1
  · simp only [he, if_false] at ha hb
    cases ha; intro h; cases h.1

#print axioms NonosExtraction.EncodeQueue.never_empty_and_full

end NonosExtraction.EncodeQueue
