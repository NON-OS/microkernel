types, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.MemorySanitizationTypes

open Aeneas Aeneas.Std Result
open nonos_x_memory_sanitization_types

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.MemorySanitizationTypes

/-! ### The forwarding functions add nothing -/

theorem the_sanitizationlevel_from_u64_wrapper_is_its_method (a : Std.U64) :
    sanitizationlevel_from_u64 a = types.SanitizationLevel.from_u64 a := rfl

theorem the_stackcanaryconfig_is_enabled_wrapper_is_its_method (a : types.StackCanaryConfig) :
    stackcanaryconfig_is_enabled a = types.StackCanaryConfig.is_enabled a := rfl

theorem the_stackcanaryconfig_get_canary_wrapper_is_its_method (a : types.StackCanaryConfig) :
    stackcanaryconfig_get_canary a = types.StackCanaryConfig.get_canary a := rfl

theorem the_stackcanaryconfig_get_frequency_wrapper_is_its_method (a : types.StackCanaryConfig) :
    stackcanaryconfig_get_frequency a = types.StackCanaryConfig.get_frequency a := rfl

theorem the_stackcanaryconfig_verify_wrapper_is_its_method (a : types.StackCanaryConfig) (b : Std.U64) :
    stackcanaryconfig_verify a b = types.StackCanaryConfig.verify a b := rfl

theorem the_sanitizationstats_get_bytes_sanitized_wrapper_is_its_method (a : types.SanitizationStats) :
    sanitizationstats_get_bytes_sanitized a = types.SanitizationStats.get_bytes_sanitized a := rfl

theorem the_sanitizationstats_get_call_count_wrapper_is_its_method (a : types.SanitizationStats) :
    sanitizationstats_get_call_count a = types.SanitizationStats.get_call_count a := rfl

theorem the_sanitizationstats_is_canary_enabled_wrapper_is_its_method (a : types.SanitizationStats) :
    sanitizationstats_is_canary_enabled a = types.SanitizationStats.is_canary_enabled a := rfl

theorem the_sanitizationstats_avg_bytes_per_call_wrapper_is_its_method (a : types.SanitizationStats) :
    sanitizationstats_avg_bytes_per_call a = types.SanitizationStats.avg_bytes_per_call a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.MemorySanitizationTypes.the_sanitizationlevel_from_u64_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_stackcanaryconfig_is_enabled_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_stackcanaryconfig_get_canary_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_stackcanaryconfig_get_frequency_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_stackcanaryconfig_verify_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_sanitizationstats_get_bytes_sanitized_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_sanitizationstats_get_call_count_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_sanitizationstats_is_canary_enabled_wrapper_is_its_method
#print axioms NonosExtraction.MemorySanitizationTypes.the_sanitizationstats_avg_bytes_per_call_wrapper_is_its_method

end NonosExtraction.MemorySanitizationTypes
