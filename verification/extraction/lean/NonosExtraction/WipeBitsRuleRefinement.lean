bits_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.WipeBitsRule
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_wipe_bits_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.WipeBitsRule

/-! ### The forwarding functions add nothing -/

theorem the_not_ready_wrapper_is_its_method (a : Std.U32) :
    not_ready a = bits_rule.not_ready a := rfl

theorem the_devctl_after_wrapper_is_its_method (a : Std.U16) :
    devctl_after a = bits_rule.devctl_after a := rfl

theorem the_devctl2_after_wrapper_is_its_method (a : Std.U16) (b : Std.U16) :
    devctl2_after a b = bits_rule.devctl2_after a b := rfl

theorem the_pmcsr_to_wrapper_is_its_method (a : Std.U16) (b : Std.U16) :
    pmcsr_to a b = bits_rule.pmcsr_to a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.WipeBitsRule.the_not_ready_wrapper_is_its_method
#print axioms NonosExtraction.WipeBitsRule.the_devctl_after_wrapper_is_its_method
#print axioms NonosExtraction.WipeBitsRule.the_devctl2_after_wrapper_is_its_method
#print axioms NonosExtraction.WipeBitsRule.the_pmcsr_to_wrapper_is_its_method

/-! ### What the code decides -/

private theorem clear_bits (c off b : Std.U16)
    (hb : ∀ i, b.val.testBit i = true → off.val.testBit i = true) :
    ((c &&& ~~~off) &&& b) = 0#u16 := by
  apply UScalar.eq_of_val_eq
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [UScalar.val_and, Nat.testBit_and, Bits.testBit_val_not]
  cases hbi : b.val.testBit i
  · simp
  · rw [hb i hbi]; simp

private theorem or_covers_left (a b : Std.U16) (i : Nat) (h : a.val.testBit i = true) :
    (a ||| b).val.testBit i = true := by
  rw [UScalar.val_or, Nat.testBit_or, h]; rfl

private theorem or_covers_right (a b : Std.U16) (i : Nat) (h : b.val.testBit i = true) :
    (a ||| b).val.testBit i = true := by
  rw [UScalar.val_or, Nat.testBit_or, h]; cases a.val.testBit i <;> rfl

/-- **A wiped device leaves with no FLR pending and no snoop bypass.** -/
theorem devctl_after_clears (b r flr ns : Std.U16) (h : devctl_after b = ok r)
    (hf : bits_rule.INITIATE_FLR = ok flr) (hn : bits_rule.NO_SNOOP_EN = ok ns) :
    (r &&& flr) = 0#u16 ∧ (r &&& ns) = 0#u16 := by
  unfold devctl_after bits_rule.devctl_after at h
  simp only [hf, hn, lift, bind_tc_ok, Result.ok.injEq] at h
  subst h
  exact ⟨clear_bits b (flr ||| ns) flr (fun i hi => or_covers_left flr ns i hi),
    clear_bits b (flr ||| ns) ns (fun i hi => or_covers_right flr ns i hi)⟩

#print axioms NonosExtraction.WipeBitsRule.devctl_after_clears

end NonosExtraction.WipeBitsRule
