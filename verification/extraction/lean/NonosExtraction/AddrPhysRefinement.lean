phys, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.AddrPhys

open Aeneas Aeneas.Std Result
open nonos_x_addr_phys

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.AddrPhys

/-! ### The forwarding functions add nothing -/

theorem the_physaddr_new_wrapper_is_its_method (a : Std.U64) :
    physaddr_new a = phys.PhysAddr.new a := rfl

theorem the_physaddr_zero_wrapper_is_its_method :
    physaddr_zero = phys.PhysAddr.zero := rfl

theorem the_physaddr_as_u64_wrapper_is_its_method (a : phys.PhysAddr) :
    physaddr_as_u64 a = phys.PhysAddr.as_u64 a := rfl

theorem the_physaddr_as_usize_wrapper_is_its_method (a : phys.PhysAddr) :
    physaddr_as_usize a = phys.PhysAddr.as_usize a := rfl

theorem the_physaddr_is_null_wrapper_is_its_method (a : phys.PhysAddr) :
    physaddr_is_null a = phys.PhysAddr.is_null a := rfl

theorem the_physaddr_is_aligned_wrapper_is_its_method (a : phys.PhysAddr) (b : Std.U64) :
    physaddr_is_aligned a b = phys.PhysAddr.is_aligned a b := rfl

theorem the_physaddr_align_down_wrapper_is_its_method (a : phys.PhysAddr) (b : Std.U64) :
    physaddr_align_down a b = phys.PhysAddr.align_down a b := rfl

theorem the_physaddr_align_up_wrapper_is_its_method (a : phys.PhysAddr) (b : Std.U64) :
    physaddr_align_up a b = phys.PhysAddr.align_up a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.AddrPhys.the_physaddr_new_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_zero_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_as_u64_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_as_usize_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_is_null_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_is_aligned_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_align_down_wrapper_is_its_method
#print axioms NonosExtraction.AddrPhys.the_physaddr_align_up_wrapper_is_its_method

end NonosExtraction.AddrPhys
