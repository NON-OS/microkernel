/-! ### What the flags mean

    These are RISC-V page table entry bits, so `W` and `X` together on one entry
    is a page that is both writable and executable. The builders below are the
    only way this module constructs an entry, and nothing in it refuses that
    combination.

    The flag constants are extracted as `irreducible`, so each proof unfolds the
    wrapper, its method and the constants it reads. That is mechanical and it is
    why the statements are small.
-/

/-- Each builder sets exactly its own bit. -/
theorem the_valid_builder_sets_bit_zero : pteflags_valid 0#u64 = ok 1#u64 := by
  unfold pteflags_valid flags.PteFlags.valid flags.PteFlags.V; rfl

theorem the_writable_builder_sets_bit_two : pteflags_writable 0#u64 = ok 4#u64 := by
  unfold pteflags_writable flags.PteFlags.writable flags.PteFlags.W; rfl

theorem the_executable_builder_sets_bit_three :
    pteflags_executable 0#u64 = ok 8#u64 := by
  unfold pteflags_executable flags.PteFlags.executable flags.PteFlags.X; rfl

theorem the_user_builder_sets_bit_four : pteflags_user 0#u64 = ok 16#u64 := by
  unfold pteflags_user flags.PteFlags.user flags.PteFlags.U; rfl

/-- The finding, stated as a construction rather than an opinion. Nothing in this
    module refuses a page that is writable and executable at once. The two
    builders compose and the result reports both.

    The x86_64 side has a W^X check over its own encoder, proven in
    `PolicyRefinement`. This backend has no equivalent, so whatever refuses the
    combination has to sit above it, and nothing in this file does. -/
theorem nothing_here_refuses_write_and_execute :
    (do let a ← pteflags_writable 0#u64; pteflags_executable a) = ok 12#u64 := by
  unfold pteflags_writable pteflags_executable flags.PteFlags.writable
    flags.PteFlags.executable flags.PteFlags.W flags.PteFlags.X
  rfl

theorem and_that_entry_reports_both :
    pteflags_is_writable 12#u64 = ok true := by
  unfold pteflags_is_writable flags.PteFlags.is_writable flags.PteFlags.W; rfl

theorem and_reports_executable_too :
    pteflags_is_executable 12#u64 = ok true := by
  unfold pteflags_is_executable flags.PteFlags.is_executable flags.PteFlags.X; rfl

/-- Validity is the low bit and is independent of the permission bits, so an
    entry built with permissions and never marked valid still reports as
    writable while the hardware will not walk it. Worth knowing when reading a
    dump. -/
theorem permissions_are_reported_on_an_invalid_entry :
    pteflags_is_valid 12#u64 = ok false := by
  unfold pteflags_is_valid flags.PteFlags.is_valid flags.PteFlags.V; rfl

