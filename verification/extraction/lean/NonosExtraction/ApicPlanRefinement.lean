plan, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ApicPlan
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_apic_plan

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ApicPlan

/-! ### The forwarding functions add nothing -/

theorem the_base_phys_wrapper_is_its_method (a : Std.U64) :
    base_phys a = plan.base_phys a := rfl

theorem the_dest_reachable_wrapper_is_its_method (a : Std.U32) (b : Bool) :
    dest_reachable a b = plan.dest_reachable a b := rfl

theorem the_x2apic_icr_wrapper_is_its_method (a : Std.U32) (b : Std.U32) :
    x2apic_icr a b = plan.x2apic_icr a b := rfl

theorem the_needs_init_deassert_wrapper_is_its_method (a : Bool) (b : Std.U32) :
    needs_init_deassert a b = plan.needs_init_deassert a b := rfl

theorem the_park_icr_low_wrapper_is_its_method :
    park_icr_low = plan.park_icr_low := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ApicPlan.the_base_phys_wrapper_is_its_method
#print axioms NonosExtraction.ApicPlan.the_dest_reachable_wrapper_is_its_method
#print axioms NonosExtraction.ApicPlan.the_x2apic_icr_wrapper_is_its_method
#print axioms NonosExtraction.ApicPlan.the_needs_init_deassert_wrapper_is_its_method
#print axioms NonosExtraction.ApicPlan.the_park_icr_low_wrapper_is_its_method

/-! ### What the code decides -/

/-- `dest_reachable` is `x2apic || apic_id <= 254`. -/
theorem dest_reachable_spec (id : Std.U32) (x : Bool) :
    dest_reachable id x = ok (x || decide (id ≤ plan.XAPIC_MAX_DEST)) := by
  unfold dest_reachable plan.dest_reachable
  cases x <;> simp

/-- In x2APIC mode every destination is reachable. -/
theorem x2apic_reaches_all (id : Std.U32) : dest_reachable id true = ok true := by
  unfold dest_reachable plan.dest_reachable; simp

#print axioms NonosExtraction.ApicPlan.dest_reachable_spec
#print axioms NonosExtraction.ApicPlan.x2apic_reaches_all

end NonosExtraction.ApicPlan
