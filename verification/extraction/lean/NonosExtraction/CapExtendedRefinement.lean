extended, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.CapExtended

open Aeneas Aeneas.Std Result
open nonos_x_cap_extended

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.CapExtended

/-! ### The forwarding functions add nothing -/

theorem the_snoop_control_wrapper_is_its_method (a : Std.U64) :
    snoop_control a = extended.snoop_control a := rfl

theorem the_queued_invalidation_wrapper_is_its_method (a : Std.U64) :
    queued_invalidation a = extended.queued_invalidation a := rfl

theorem the_interrupt_remapping_wrapper_is_its_method (a : Std.U64) :
    interrupt_remapping a = extended.interrupt_remapping a := rfl

theorem the_extended_interrupt_mode_wrapper_is_its_method (a : Std.U64) :
    extended_interrupt_mode a = extended.extended_interrupt_mode a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.CapExtended.the_snoop_control_wrapper_is_its_method
#print axioms NonosExtraction.CapExtended.the_queued_invalidation_wrapper_is_its_method
#print axioms NonosExtraction.CapExtended.the_interrupt_remapping_wrapper_is_its_method
#print axioms NonosExtraction.CapExtended.the_extended_interrupt_mode_wrapper_is_its_method

end NonosExtraction.CapExtended
