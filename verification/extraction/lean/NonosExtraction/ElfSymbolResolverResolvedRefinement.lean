resolved, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ElfSymbolResolverResolved

open Aeneas Aeneas.Std Result
open nonos_x_elf_symbol_resolver_resolved

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ElfSymbolResolverResolved

/-! ### The forwarding functions add nothing -/

theorem the_resolvedsymbol_is_function_wrapper_is_its_method (a : elf.symbol.resolver.resolved.ResolvedSymbol) :
    resolvedsymbol_is_function a = elf.symbol.resolver.resolved.ResolvedSymbol.is_function a := rfl

theorem the_resolvedsymbol_is_object_wrapper_is_its_method (a : elf.symbol.resolver.resolved.ResolvedSymbol) :
    resolvedsymbol_is_object a = elf.symbol.resolver.resolved.ResolvedSymbol.is_object a := rfl

theorem the_resolvedsymbol_is_global_wrapper_is_its_method (a : elf.symbol.resolver.resolved.ResolvedSymbol) :
    resolvedsymbol_is_global a = elf.symbol.resolver.resolved.ResolvedSymbol.is_global a := rfl

theorem the_resolvedsymbol_is_weak_wrapper_is_its_method (a : elf.symbol.resolver.resolved.ResolvedSymbol) :
    resolvedsymbol_is_weak a = elf.symbol.resolver.resolved.ResolvedSymbol.is_weak a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ElfSymbolResolverResolved.the_resolvedsymbol_is_function_wrapper_is_its_method
#print axioms NonosExtraction.ElfSymbolResolverResolved.the_resolvedsymbol_is_object_wrapper_is_its_method
#print axioms NonosExtraction.ElfSymbolResolverResolved.the_resolvedsymbol_is_global_wrapper_is_its_method
#print axioms NonosExtraction.ElfSymbolResolverResolved.the_resolvedsymbol_is_weak_wrapper_is_its_method

end NonosExtraction.ElfSymbolResolverResolved
