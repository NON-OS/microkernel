types, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.FsVfsTypes

open Aeneas Aeneas.Std Result
open nonos_x_fs_vfs_types

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.FsVfsTypes

/-! ### The forwarding functions add nothing -/

theorem the_openflags_empty_wrapper_is_its_method :
    openflags_empty = fs.vfs.types.OpenFlags.empty := rfl

theorem the_openflags_from_bits_wrapper_is_its_method (a : Std.U32) :
    openflags_from_bits a = fs.vfs.types.OpenFlags.from_bits a := rfl

theorem the_openflags_bits_wrapper_is_its_method (a : fs.vfs.types.OpenFlags) :
    openflags_bits a = fs.vfs.types.OpenFlags.bits a := rfl

theorem the_openflags_contains_wrapper_is_its_method (a : fs.vfs.types.OpenFlags) (b : fs.vfs.types.OpenFlags) :
    openflags_contains a b = fs.vfs.types.OpenFlags.contains a b := rfl

theorem the_openflags_is_readable_wrapper_is_its_method (a : fs.vfs.types.OpenFlags) :
    openflags_is_readable a = fs.vfs.types.OpenFlags.is_readable a := rfl

theorem the_openflags_is_writable_wrapper_is_its_method (a : fs.vfs.types.OpenFlags) :
    openflags_is_writable a = fs.vfs.types.OpenFlags.is_writable a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.FsVfsTypes.the_openflags_empty_wrapper_is_its_method
#print axioms NonosExtraction.FsVfsTypes.the_openflags_from_bits_wrapper_is_its_method
#print axioms NonosExtraction.FsVfsTypes.the_openflags_bits_wrapper_is_its_method
#print axioms NonosExtraction.FsVfsTypes.the_openflags_contains_wrapper_is_its_method
#print axioms NonosExtraction.FsVfsTypes.the_openflags_is_readable_wrapper_is_its_method
#print axioms NonosExtraction.FsVfsTypes.the_openflags_is_writable_wrapper_is_its_method

end NonosExtraction.FsVfsTypes
