regs, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.AmdViRegs

open Aeneas Aeneas.Std Result
open nonos_x_amd_vi_regs

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.AmdViRegs

/-! ### The forwarding functions add nothing -/

theorem the_invalidate_all_supported_wrapper_is_its_method (a : Std.U64) :
    invalidate_all_supported a = regs.invalidate_all_supported a := rfl

theorem the_dev_table_base_wrapper_is_its_method (a : Std.U64) (b : Std.Usize) :
    dev_table_base a b = regs.dev_table_base a b := rfl

theorem the_ring_base_wrapper_is_its_method (a : Std.U64) :
    ring_base a = regs.ring_base a := rfl

theorem the_ring_offset_wrapper_is_its_method (a : Std.U16) :
    ring_offset a = regs.ring_offset a := rfl

theorem the_ring_index_wrapper_is_its_method (a : Std.U64) :
    ring_index a = regs.ring_index a := rfl

theorem the_ring_next_wrapper_is_its_method (a : Std.U16) :
    ring_next a = regs.ring_next a := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.AmdViRegs.the_invalidate_all_supported_wrapper_is_its_method
#print axioms NonosExtraction.AmdViRegs.the_dev_table_base_wrapper_is_its_method
#print axioms NonosExtraction.AmdViRegs.the_ring_base_wrapper_is_its_method
#print axioms NonosExtraction.AmdViRegs.the_ring_offset_wrapper_is_its_method
#print axioms NonosExtraction.AmdViRegs.the_ring_index_wrapper_is_its_method
#print axioms NonosExtraction.AmdViRegs.the_ring_next_wrapper_is_its_method

/-! ### Arithmetic -/

/-- **The command ring index never leaves the ring.** Whatever index comes
    in, the next one is below the ring's 256 entries. -/
theorem ring_next_in_ring (i r : Std.U16) (h : ring_next i = ok r) :
    r.val < regs.RING_ENTRIES.val := by
  unfold ring_next regs.ring_next at h
  cases ha : (i + 1#u16) with
  | ok j =>
      simp only [ha, bind_tc_ok] at h
      have hne : regs.RING_ENTRIES.val ≠ 0 := by unfold regs.RING_ENTRIES; decide
      obtain ⟨z, hz, hp⟩ := WP.spec_imp_exists (UScalar.rem_bv_spec j hne)
      rw [hz] at h
      cases h
      rw [hp.1]
      exact Nat.mod_lt _ (Nat.pos_of_ne_zero hne)
  | fail e => simp [ha] at h
  | div => simp [ha] at h

#print axioms NonosExtraction.AmdViRegs.ring_next_in_ring

end NonosExtraction.AmdViRegs
