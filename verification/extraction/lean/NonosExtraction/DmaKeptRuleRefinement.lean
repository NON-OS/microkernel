kept_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.DmaKeptRule

open Aeneas Aeneas.Std Result
open nonos_x_dma_kept_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.DmaKeptRule

/-! ### The forwarding functions add nothing -/

theorem the_keeps_wrapper_is_its_method (a : Bool) (b : Bool) (c : Bool) :
    keeps a b c = kept_rule.keeps a b c := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.DmaKeptRule.the_keeps_wrapper_is_its_method

/-! ### What the rule decides, exactly -/

/-- `keeps` is `pci && !confined && released`. -/
theorem keeps_spec (p c r : Bool) : keeps p c r = ok (p && !c && r) := by
  cases p <;> cases c <;> cases r <;> rfl

/-- **An unconfined PCI grant drained by a release is kept for the wipe**, so
    its frames are not reused while the device could still reach them. -/
theorem unconfined_release_kept : keeps true false true = ok true := rfl

#print axioms NonosExtraction.DmaKeptRule.keeps_spec
#print axioms NonosExtraction.DmaKeptRule.unconfined_release_kept

end NonosExtraction.DmaKeptRule
