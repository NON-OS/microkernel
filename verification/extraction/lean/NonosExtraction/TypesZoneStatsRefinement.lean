zone_stats, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.TypesZoneStats

open Aeneas Aeneas.Std Result
open nonos_x_types_zone_stats

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.TypesZoneStats

/-! ### The forwarding functions add nothing -/

theorem the_zonestats_new_wrapper_is_its_method (a : Std.Usize) (b : Std.Usize) :
    zonestats_new a b = zone_stats.ZoneStats.new a b := rfl

theorem the_zonestats_frames_allocated_wrapper_is_its_method (a : zone_stats.ZoneStats) :
    zonestats_frames_allocated a = zone_stats.ZoneStats.frames_allocated a := rfl

theorem the_zonestats_usage_percent_wrapper_is_its_method (a : zone_stats.ZoneStats) :
    zonestats_usage_percent a = zone_stats.ZoneStats.usage_percent a := rfl

theorem the_zonestats_total_bytes_wrapper_is_its_method (a : zone_stats.ZoneStats) (b : Std.Usize) :
    zonestats_total_bytes a b = zone_stats.ZoneStats.total_bytes a b := rfl

theorem the_zonestats_free_bytes_wrapper_is_its_method (a : zone_stats.ZoneStats) (b : Std.Usize) :
    zonestats_free_bytes a b = zone_stats.ZoneStats.free_bytes a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.TypesZoneStats.the_zonestats_new_wrapper_is_its_method
#print axioms NonosExtraction.TypesZoneStats.the_zonestats_frames_allocated_wrapper_is_its_method
#print axioms NonosExtraction.TypesZoneStats.the_zonestats_usage_percent_wrapper_is_its_method
#print axioms NonosExtraction.TypesZoneStats.the_zonestats_total_bytes_wrapper_is_its_method
#print axioms NonosExtraction.TypesZoneStats.the_zonestats_free_bytes_wrapper_is_its_method

end NonosExtraction.TypesZoneStats
