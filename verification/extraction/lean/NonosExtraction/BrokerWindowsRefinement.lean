windows, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.BrokerWindows
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_broker_windows

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.BrokerWindows

/-! ### The forwarding functions add nothing -/

theorem the_touches_device_window_wrapper_is_its_method (a : Std.U64) (b : Std.U64) :
    touches_device_window a b = windows.touches_device_window a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.BrokerWindows.the_touches_device_window_wrapper_is_its_method

/-! ### What the code decides -/

/-- **An overflowing range fails closed.** A range whose end does not fit in
    64 bits is reported as touching a device window, so it is refused. -/
theorem overflow_touches (a l : Std.U64) (h : U64.checked_add a l = none) :
    touches_device_window a l = ok true := by
  unfold touches_device_window windows.touches_device_window
  simp [lift, h]

#print axioms NonosExtraction.BrokerWindows.overflow_touches

/-! ### Arithmetic -/

/-- `overlaps` is the half-open interval test `start < hi ∧ end > lo`. -/
theorem overlaps_spec (s e lo hi : Std.U64) :
    windows.overlaps s e lo hi = ok (decide (s < hi) && decide (e > lo)) := by
  unfold windows.overlaps
  by_cases hs : s < hi <;> simp [hs]

#print axioms NonosExtraction.BrokerWindows.overlaps_spec

end NonosExtraction.BrokerWindows
