command_rule, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.PciCommandRule
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_pci_command_rule

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.PciCommandRule

/-! ### The forwarding functions add nothing -/

theorem the_at_claim_wrapper_is_its_method (a : Std.U16) (b : Bool) :
    at_claim a b = command_rule.at_claim a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.PciCommandRule.the_at_claim_wrapper_is_its_method

/-! ### What the code decides -/

private theorem clear_bits (c off b : Std.U16)
    (hb : ∀ i, b.val.testBit i = true → off.val.testBit i = true) :
    ((c &&& ~~~off) &&& b) = 0#u16 := by
  apply UScalar.eq_of_val_eq
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [UScalar.val_and, Nat.testBit_and, Bits.testBit_val_not]
  cases hbi : b.val.testBit i
  · simp
  · rw [hb i hbi]; simp

private theorem or_covers_left (a b : Std.U16) (i : Nat) (h : a.val.testBit i = true) :
    (a ||| b).val.testBit i = true := by
  rw [UScalar.val_or, Nat.testBit_or, h]; rfl

private theorem or_covers_right (a b : Std.U16) (i : Nat) (h : b.val.testBit i = true) :
    (a ||| b).val.testBit i = true := by
  rw [UScalar.val_or, Nat.testBit_or, h]; cases a.val.testBit i <;> rfl

/-- **A claimed device never keeps bus mastering.** Whatever the command
    register read, the word written at claim has Bus Master clear, so the
    device cannot start DMA until its driver turns it on under its domain. -/
theorem claim_clears_bus_master (cur : Std.U16) (po : Bool) (r b : Std.U16)
    (h : at_claim cur po = ok r) (hb : command_rule.BUS_MASTER = ok b) : (r &&& b) = 0#u16 := by
  unfold at_claim command_rule.at_claim at h
  cases po
  · simp only [hb, lift, bind_tc_ok, Bool.false_eq_true, if_false, Result.ok.injEq] at h
    subst h
    exact clear_bits cur b b (fun _ h => h)
  · cases hm : command_rule.MEMORY_SPACE with
    | ok m =>
        simp only [hb, hm, lift, bind_tc_ok, if_true, Result.ok.injEq] at h
        subst h
        exact clear_bits cur (b ||| m) b (fun i hi => or_covers_left b m i hi)
    | fail e => simp [hb, hm, lift] at h
    | div => simp [hb, hm, lift] at h

/-- A port-only claim also clears memory decoding. -/
theorem port_only_clears_memory (cur : Std.U16) (r b m : Std.U16)
    (h : at_claim cur true = ok r) (hb : command_rule.BUS_MASTER = ok b)
    (hm : command_rule.MEMORY_SPACE = ok m) : (r &&& m) = 0#u16 := by
  unfold at_claim command_rule.at_claim at h
  simp only [hb, hm, lift, bind_tc_ok, if_true, Result.ok.injEq] at h
  subst h
  exact clear_bits cur (b ||| m) m (fun i hi => or_covers_right b m i hi)

#print axioms NonosExtraction.PciCommandRule.claim_clears_bus_master
#print axioms NonosExtraction.PciCommandRule.port_only_clears_memory

end NonosExtraction.PciCommandRule
