types, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.ServicesCapsTypes

open Aeneas Aeneas.Std Result
open nonos_x_services_caps_types

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.ServicesCapsTypes

/-! ### The forwarding functions add nothing -/

theorem the_servicecap_new_wrapper_is_its_method (a : Std.U64) (b : Std.U32) :
    servicecap_new a b = services.caps.types.ServiceCap.new a b := rfl

theorem the_servicecap_with_expiry_wrapper_is_its_method (a : Std.U64) (b : Std.U32) (c : Std.U64) :
    servicecap_with_expiry a b c = services.caps.types.ServiceCap.with_expiry a b c := rfl

theorem the_servicecap_has_wrapper_is_its_method (a : services.caps.types.ServiceCap) (b : Std.U64) :
    servicecap_has a b = services.caps.types.ServiceCap.has a b := rfl

theorem the_servicecap_is_expired_wrapper_is_its_method (a : services.caps.types.ServiceCap) (b : Std.U64) :
    servicecap_is_expired a b = services.caps.types.ServiceCap.is_expired a b := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.ServicesCapsTypes.the_servicecap_new_wrapper_is_its_method
#print axioms NonosExtraction.ServicesCapsTypes.the_servicecap_with_expiry_wrapper_is_its_method
#print axioms NonosExtraction.ServicesCapsTypes.the_servicecap_has_wrapper_is_its_method
#print axioms NonosExtraction.ServicesCapsTypes.the_servicecap_is_expired_wrapper_is_its_method

end NonosExtraction.ServicesCapsTypes
