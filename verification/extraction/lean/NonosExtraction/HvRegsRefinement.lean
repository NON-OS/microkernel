regs, on the extracted code.

Charon cannot take an inherent method as an entry point, so the crate root
carries a free function per method and those are the names the manifest counts.
A wrapper that quietly did something other than call through would make every
theorem about the method a statement about code nobody runs, so each one is
proven to be its method below.

These are generated by tools/extraction/mirror_crate.py and are the floor, not
the point. The properties that matter go beneath them, and the shapes most of
them take are stated once in NonosExtraction.Shapes.
-/

import NonosExtraction.HvRegs
import NonosExtraction.Bits

open Aeneas Aeneas.Std Result
open nonos_x_hv_regs

set_option linter.hashCommand false
set_option maxRecDepth 100000

namespace NonosExtraction.HvRegs

/-! ### The forwarding functions add nothing -/

theorem the_page_wrapper_is_its_method (a : Std.U64) :
    page a = regs.page a := rfl

theorem the_sint_wrapper_is_its_method (a : Std.U8) (b : Bool) :
    sint a b = regs.sint a b := rfl

theorem the_scontrol_enabled_wrapper_is_its_method :
    scontrol_enabled = regs.scontrol_enabled := rfl

/-! ### Axiom profile -/

#print axioms NonosExtraction.HvRegs.the_page_wrapper_is_its_method
#print axioms NonosExtraction.HvRegs.the_sint_wrapper_is_its_method
#print axioms NonosExtraction.HvRegs.the_scontrol_enabled_wrapper_is_its_method

/-! ### What the code decides -/

/-- **The Hyper-V page register is always written enabled.** -/
theorem page_enabled (g r : Std.U64) (h : page g = ok r) :
    (r &&& regs.ENABLE) = regs.ENABLE := by
  unfold page regs.page at h
  simp only [lift, bind_tc_ok, Result.ok.injEq] at h
  subst h
  apply UScalar.eq_of_val_eq
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [UScalar.val_and, UScalar.val_or, Nat.testBit_and, Nat.testBit_or]
  cases regs.ENABLE.val.testBit i <;> simp

#print axioms NonosExtraction.HvRegs.page_enabled

end NonosExtraction.HvRegs
