# payment — the meter. Signs cumulative NOX vouchers for prefunded
# channels under the owner's budget. Its keys are its own, generated by the
# keyring and sealed in the keyring's holder-bound record for this endpoint;
# the keyring signs, the meter never holds the secp256k1 secret. CoreExec for
# getpid, IPC, Memory, Crypto, and FileSystem for its state file. No Network:
# capsule_nox_settle talks to the chain.

CAPSULE_SLUG             := payment
CAPSULE_HANDLE           := payment
CAPSULE_DOMAIN           := systems.nonos
CAPSULE_DIR              := userland/capsule_payment
CAPSULE_BIN_NAME         := payment
CAPSULE_FEATURE          := nonos-capsule-payment
CAPSULE_NAMESPACE        := systems.nonos.payment
# 4110 and 4111 belonged to wallpaper_catalog, which the kernel spawn plan
# hardcodes; whichever of the two registered second would have failed. The
# reply name stays the kernel endpoint this capsule sends replies to
# (KERNEL_REPLY_ENDPOINT, 0x1_0000_001B), as the driver capsules do;
# 0x1_0000_0010 was driver_hda's reply inbox.
CAPSULE_SERVICE_ENDPOINT := service:4114:payment
CAPSULE_REPLY_ENDPOINT   := reply:4115:endpoint.4294967323
# CoreExec | IPC | Memory | Crypto | FileSystem | Keyring
#   = 0x01 | 0x08 | 0x10 | 0x20 | 0x40 | 0x10000000. Keyring because its key is
# generated and signs in the keyring, which the kernel admits a sender to only
# with the bit (src/services/registry/policy.rs).
CAPSULE_REQUIRED_CAPS    := 0x10000079
CAPSULE_KERNEL_MIRROR    := src/userspace/capsule_payment

include nonos-mk/capsule.mk
