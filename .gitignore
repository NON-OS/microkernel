# Redox donor source: a local reference only, not redistributed.
# Ignore the vendored source but keep the audit manifest tracked.
third_party/redox/*
!third_party/redox/IMPORT_MAP.md

# Build outputs
target/
# nix build's links to its outputs
/result
/result-*
*.iso
*.img
*.bin
!firmware/*.fd
!nonos-bootloader/firmware/**/*.bin
# Captured proof vectors are source, not build output.
!userland/*_proofs/vectors/*.bin
# The pinned wallet vectors Test 5 proves on the machine.
!userland/capsule_shield_vectors/vectors/*/proof-format7.bin

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node
node_modules/

# Secrets and keys { NEVER COMMITTED }
/keys/
.keys/*
!.keys/.gitignore
!src/**/keys/
*.key
*.pem
*_key.bin
*_key.json
signing_key*.bin
signing_key*.json
dev_signing_key.bin
*.secret
# Belt and suspenders: refuse seed files anywhere in the tree.
*.seed

# NØNOS baked trust artifacts ship under nonos-data/trust/ so CI
# can reverify the policy + per-capsule cert + manifest without
# secrets. Seeds remain ignored above.
!nonos-data/trust/
!nonos-data/trust/**
!nonos-data/trust/**/*.bin
!nonos-data/trust/**/*.pub

# Editor and tool backup files.
*.bak

# ZK artifacts (generated, large)
zk-artifacts/generated/
zk-artifacts/*.bin
zk-artifacts/*.json
!zk-artifacts/README.md
generated_keys/

# Logs and temp files
*.log
*.tmp
*.temp

# Build cache
.cargo/
.rustup/

# Test outputs
test-results/
coverage/

# Local config overrides
.env
.env.local
*.local.toml


# Bootloader key material (private seeds + signing key, never commit)
nonos-bootloader/keys/

# Local scratch
.proof-harness/

# stray dev symlink, never track (dir form above only ignores contents)
nonos-bootloader/keys

# Per-user kernel build configuration written by tools/nonos-config
.nonos-config

# Build output from vendored crates.io tool sources
userland/upstream-src/*/target/
userland/capsule_net_nym/tests/live_gateway/target/

# Folded-in trees keep the artifacts their own repos tracked.
!stark-attest/**/*.bin
!nonos-data/**/*.bin
!nonos-data/cacert.pem

# Evidence is committed whole: its logs and captured files are the proof.

# CI writes its reports here; a binary in them is never evidence.
ci-reports/**/nonos-kernel*

# Proof vectors are inputs, not build outputs.
!userland/*_proofs/vectors/*.bin
